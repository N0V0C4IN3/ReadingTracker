# Copy to `.env` beside docker-compose.pi.yml on the Pi. Never commit the result.
#
#   cp deploy/pi/.env.example .env

# Invented once, on the Pi, for the local Postgres and RabbitMQ. These are not shared with
# anything, and they are not the old Neon or CloudAMQP credentials -- those accounts are retired.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# The same public Google OAuth client the Azure deployment uses. Public by design: it identifies
# the application, it does not authenticate it, and it ships inside the frontend where anyone can
# read it.
GOOGLE_CLIENT_ID=

# Where the frontend is served from -- it stays on Azure Static Web Apps (ADR-0012). The Gateway
# refuses to start without this, and a browser on any other origin cannot call it.
ALLOWED_ORIGIN=https://thankful-bush-00466b40f.6.azurestaticapps.net

# Optional. Catalog falls back to Open Library when this is unset, so an absent key degrades book
# search rather than breaking it.
GOOGLE_BOOKS_API_KEY=

# A Tailscale auth key from https://login.tailscale.com/admin/settings/keys
#
# Generate it WITHOUT tags: an untagged key makes the node yours, which puts it in
# `autogroup:member`, which is who the default tailnet policy grants Funnel to. A tagged node
# would need a matching `nodeAttrs` entry in the policy file before Funnel would work at all.
#
# The joined state persists in the `tailscale-state` volume across restarts, so a single-use key
# is enough unless you expect to recreate that volume.
TS_AUTHKEY=
