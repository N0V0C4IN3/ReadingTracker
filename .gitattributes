# Every text file is LF in the repository and in the working copy, on Windows too. With
# core.autocrlf the working copy was CRLF while the repository was LF, so a file written by a
# tool came out LF beside its CRLF neighbours, and edits had to match line endings by hand.
* text=auto eol=lf

# Shell scripts and the Lua the Kindle runs must stay LF whatever the checkout: sh trips on a
# carriage return, and a plugin file edited on Windows would otherwise ship with them.
*.sh text eol=lf
readingtracker.koplugin/** text eol=lf
