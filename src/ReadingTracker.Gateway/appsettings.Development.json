{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The OAuth client tokens must be issued to. A client id is public by design — it ships inside
  // the browser application — so it is committed rather than kept in .env. The client secret is
  // a different matter and is not used: the browser is a public client.
  "Google": {
    "ClientId": "623181146792-48bl473grn84pjdcm7og5a3dtio6tn7i.apps.googleusercontent.com"
  },
  // The frontend as it runs locally. Not arbitrary: it is also the JavaScript origin registered
  // with Google, so the browser app only works from here anyway.
  "AllowedOrigins": ["http://localhost:5200"],
  // The two services as they run locally. Deployed environments supply these as
  // ReverseProxy__Clusters__<name>__Destinations__primary__Address instead.
  "ReverseProxy": {
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "library": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5110/"
          }
        }
      }
    }
  }
}
