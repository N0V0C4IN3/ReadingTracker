{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The two services as they run locally. Deployed environments supply these as
  // ReverseProxy__Clusters__<name>__Destinations__primary__Address instead.
  "ReverseProxy": {
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "library": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5110/"
          }
        }
      }
    }
  }
}
