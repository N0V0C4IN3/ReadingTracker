@inherits LayoutComponentBase
@implements IDisposable
@using ReadingTracker.Web.Services
@inject NavigationManager Navigation
@inject Orientation Orientation

@*
    The welcome screen goes without the bar across the top. It already says the application's name
    in type you cannot miss and offers the same way in, so the header there is the same two things
    said twice, in a strip of card colour laid over a poster.

    So does the sign-in round trip. Each leg of it — the redirect out to Google, the return — is
    the loading screen and nothing else, and a bar across the top of a loading screen is a header
    over nothing: it flashed up as the trip began and again as it ended, with a Sign in button on
    it, on a page that was in the middle of signing in.

    And so does the shelf on a phone held on its side, which is a cover flow with the screen to
    itself: turned upright, the phone has the bar again.

    Every other page keeps it, signed in or not — including the one you land on after mistyping a
    URL, where the way home is the only thing on offer.
*@
@if (!Bare)
{
    <header>
        <a href="">ReadingTracker</a>
        <ImportBadge />
        <ReadingGoalBadge />
        <LoginDisplay />
    </header>
}

<main>
    @Body
</main>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _signedIn;
    private bool _atRoot;
    private bool _signingIn;

    /// <summary>
    /// The welcome screen — the root of the site with nobody signed in — and the sign-in round
    /// trip. While the answer to "is anyone signed in" is still coming, this is true — the boot
    /// screen has no more use for a header than the welcome screen it becomes. And the shelf on a
    /// phone on its side.
    /// </summary>
    private bool Bare => (_atRoot && (!_signedIn || Orientation.Sideways)) || _signingIn;

    protected override void OnInitialized()
    {
        Locate();
        Navigation.LocationChanged += Moved;
        Orientation.Changed += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not { } pending)
        {
            return;
        }

        var state = await pending;

        _signedIn = state.User.Identity?.IsAuthenticated ?? false;
    }

    private void Locate()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/').Split('?', '#')[0];

        _atRoot = path.Length == 0;
        // The route Authentication.razor answers to: login, login-callback, logout and the rest.
        _signingIn = path.StartsWith("authentication", StringComparison.OrdinalIgnoreCase);
    }

    private void Moved(object? sender, LocationChangedEventArgs e)
    {
        var wasBare = Bare;

        Locate();

        if (wasBare != Bare)
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= Moved;
        Orientation.Changed -= StateHasChanged;
    }
}
