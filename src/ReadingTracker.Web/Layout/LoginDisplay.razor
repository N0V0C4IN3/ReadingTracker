@using Microsoft.Extensions.Options
@using ReadingTracker.Web.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<DevSignInOptions> DevSignIn
@inject GatewayDevicesClient Devices
@inject IJSRuntime JS

@*
    Who is signed in, and the way in or out.

    Signed in, that is one round initial at the end of the bar. Tapping it opens the name in full
    and the Sign out button beneath it. The bar used to carry "Signed in as <name>" and a filled
    button all the time, which on a phone was four things on one line, two of them a sentence the
    reader had no need to re-read on every page.

    Signing out is local only: it forgets the token this application is holding. Google has no
    end-session endpoint — its discovery document does not publish one — so there is no way for
    a site to end a Google session on the reader's behalf, and pretending otherwise would leave
    them believing they had signed out of more than they had.

    With dev sign-in enabled there is no Google session to forget in the first place (ADR-0009),
    and signing out is just dropping the minted token.

    The Devices row carries the devices' state in a word — "1 syncing", "2 quiet" — so a Kindle
    that has stopped talking is noticed from the menu, without opening the page. The list is asked
    for the first time the menu opens, not on every page: it is a request, and most visits never
    open the menu at all.
*@

<AuthorizeView>
    <Authorized>
        <div class="account" @onkeydown="CloseOnEscape">
            <button type="button" class="account__monogram"
                    aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")"
                    aria-label="@($"Account: {context.User.Identity?.Name}")"
                    @onclick="Toggle">@Initial(context.User.Identity?.Name)</button>

            @if (_open)
            {
                @* A tap anywhere else closes the menu; the scrim is what catches that tap. *@
                <button type="button" class="account__scrim" tabindex="-1" aria-hidden="true" @onclick="Close"></button>
                <div class="account__menu" role="menu">
                    <p class="account__who">Signed in as <strong>@context.User.Identity?.Name</strong></p>
                    <a class="account__row" role="menuitem" href="devices" @onclick="Close">
                        Devices
                        @if (DevicesSummary is { } summary)
                        {
                            <span class="pill pill--@summary.Kind.ToString().ToLowerInvariant()">
                                @if (summary.Kind == DeviceStateKind.Syncing)
                                {
                                    <i aria-hidden="true"></i>
                                }
                                @summary.Label
                            </span>
                        }
                    </a>
                    <a class="account__row" role="menuitem" href="import" @onclick="Close">Import</a>
                    <div class="account__theme">
                        <span id="dark-mode-label">Dark mode</span>
                        <button type="button" class="switch" role="switch" aria-checked="@(_dark ? "true" : "false")"
                                aria-labelledby="dark-mode-label" @onclick="ToggleDarkAsync">
                            <span class="switch__knob" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="account__out">
                        <button type="button" class="account__row" role="menuitem" @onclick="SignOut">Sign out</button>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        @if (DevSignIn.Value.Enabled)
        {
            <DevSignInForm />
        }
        else
        {
            <button @onclick="SignIn">Sign in with Google</button>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _open;
    private IReadOnlyList<Device>? _devices;
    private bool _askedForDevices;

    /// <summary>
    /// Whether the page is dark, as this browser has it. index.html stamps the choice before
    /// first paint and keeps it; this only reads it as the menu opens and writes it when the
    /// switch is flipped, so the page and the switch can never disagree.
    /// </summary>
    private bool _dark = true;

    private async Task ToggleDarkAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("readingTracker.setDark", _dark);
    }

    private async Task Toggle()
    {
        if (!_open)
        {
            // Read before the menu shows, so its first frame already has the switch right.
            _dark = await JS.InvokeAsync<bool>("readingTracker.isDark");
        }

        _open = !_open;

        if (_open && !_askedForDevices)
        {
            _askedForDevices = true;
            var listed = await Devices.ListAsync(CancellationToken.None);
            // A list that could not be fetched is no pill, not a complaint: the menu is not the
            // place, and the Devices page will say what is wrong.
            _devices = listed.Value;
        }
    }

    /// <summary>
    /// The devices in a word: how many are syncing if any are, else how many have gone quiet.
    /// Nothing for no devices, and nothing for devices never used — there is nothing to notice.
    /// </summary>
    private DeviceState? DevicesSummary
    {
        get
        {
            if (_devices is null || _devices.Count == 0)
            {
                return null;
            }

            var states = _devices.Select(device => DeviceState.Of(device, DateTimeOffset.Now).Kind).ToList();
            var syncing = states.Count(kind => kind == DeviceStateKind.Syncing);
            var quiet = states.Count(kind => kind == DeviceStateKind.Quiet);

            return syncing > 0 ? new(DeviceStateKind.Syncing, $"{syncing} syncing")
                : quiet > 0 ? new(DeviceStateKind.Quiet, $"{quiet} quiet")
                : null;
        }
    }

    private void Close() => _open = false;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    /// <summary>
    /// The first letter of the name, for the monogram. A name from Google has one; a dev reader
    /// id might be anything, and an empty one gets a placeholder rather than an empty circle.
    /// </summary>
    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private void SignIn() =>
        Navigation.NavigateToLogin("authentication/login");

    /// <summary>
    /// Signing out lands on the welcome screen, both ways round. Having asked to be signed out,
    /// there is nothing to tell a reader afterwards and nowhere else they could want to be — a
    /// page saying it happened, with a link to the only place to go, is a step they have to take
    /// to get where they were already headed.
    /// </summary>
    private async Task SignOut()
    {
        // Registered only when dev sign-in is enabled, so this is what tells the two apart.
        if (AuthenticationStateProvider is DevAuthenticationStateProvider dev)
        {
            await dev.SignOutAsync();
            Navigation.NavigateTo("/");

            return;
        }

        // The return url is what stops RemoteAuthenticatorView rendering its own "you are signed
        // out" page: given somewhere to go, it goes there instead.
        Navigation.NavigateToLogout("authentication/logout", "/");
    }
}
