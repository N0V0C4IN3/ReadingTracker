@using Microsoft.Extensions.Options
@using ReadingTracker.Web.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<DevSignInOptions> DevSignIn

@*
    Who is signed in, and the way in or out.

    Signing out is local only: it forgets the token this application is holding. Google has no
    end-session endpoint — its discovery document does not publish one — so there is no way for
    a site to end a Google session on the reader's behalf, and pretending otherwise would leave
    them believing they had signed out of more than they had.

    With dev sign-in enabled there is no Google session to forget in the first place (ADR-0009),
    and signing out is just dropping the minted token.
*@

<AuthorizeView>
    <Authorized>
        <span>Signed in as <strong>@context.User.Identity?.Name</strong></span>
        <button @onclick="SignOut">Sign out</button>
    </Authorized>
    <NotAuthorized>
        @if (DevSignIn.Value.Enabled)
        {
            <DevSignInForm />
        }
        else
        {
            <button @onclick="SignIn">Sign in with Google</button>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private void SignIn() =>
        Navigation.NavigateToLogin("authentication/login");

    /// <summary>
    /// Signing out lands on the welcome screen, both ways round. Having asked to be signed out,
    /// there is nothing to tell a reader afterwards and nowhere else they could want to be — a
    /// page saying it happened, with a link to the only place to go, is a step they have to take
    /// to get where they were already headed.
    /// </summary>
    private async Task SignOut()
    {
        // Registered only when dev sign-in is enabled, so this is what tells the two apart.
        if (AuthenticationStateProvider is DevAuthenticationStateProvider dev)
        {
            await dev.SignOutAsync();
            Navigation.NavigateTo("/");

            return;
        }

        // The return url is what stops RemoteAuthenticatorView rendering its own "you are signed
        // out" page: given somewhere to go, it goes there instead.
        Navigation.NavigateToLogout("authentication/logout", "/");
    }
}
