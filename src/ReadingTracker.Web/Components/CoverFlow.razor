@implements IDisposable
@inject IJSRuntime JS
@using System.Globalization

@*
    A deck of jackets seen at an angle, one held face-on at the front and the rest leaning away to
    either side — the shape iTunes used for album art. Every few seconds it turns a single place,
    one way or the other, which reads as a thing that is alive rather than a thing that is
    scrolling.

    It can also be taken hold of: hovering holds it where it is, any book you can see can be
    clicked to bring it to the front, and on a touch screen it can be dragged sideways with a
    finger. Each of those stops the turning for as long as the reader is doing the steering.

    It lives in its own component rather than in the welcome screen because it re-renders on a
    timer, and there is no reason for the rest of that page to re-render with it.
*@

<div class="flow @(_dressed ? "flow--dressed" : null)" @onmouseenter="Hold" @onmouseleave="Release">
    @*
        Dragged with a finger as well as turned by itself. The stylesheet sets touch-action: pan-y
        on this box, which is what lets the deck answer a sideways drag while the page keeps taking
        a vertical one — without it, either the deck never sees the gesture or the page stops
        scrolling over the one element that fills a phone screen.
    *@
    <div class="flow__stage"
         @ontouchstart="DragStart"
         @ontouchmove="DragMove"
         @ontouchend="DragEnd"
         @ontouchcancel="DragEnd">
        @foreach (var (book, position) in Wall.Select((book, at) => (book, at)))
        {
            var place = Place(position);

            @*
                A button, because it does something when you click it — and one that is genuinely
                disabled once it is too far round to see, so the far side of the deck is neither a
                tab stop nor something a screen reader offers.
            *@
            <button @key="book.Title"
                    type="button"
                    class="flow__slot @(place.Lit ? "flow__slot--lit" : null)"
                    style="@place.Style"
                    disabled="@(!place.Lit)"
                    aria-label="Show @book.Title by @book.Author"
                    @onclick="() => Show(position)">
                <span class="cover cover--@(position % CoverTones)">
                    <span class="cover__title">@book.Title</span>
                    <span class="cover__rule"></span>
                    <span class="cover__author">@book.Author</span>

                    @*
                        Laid over the drawn jacket, never instead of it: a cover that is slow,
                        throttled or gone leaves the drawn one showing rather than a hole.
                        Deliberately not lazy — a jacket that only loads once the deck has turned
                        it to the front arrives visibly late, in front of the reader.
                    *@
                    <img class="cover__art"
                         src="covers/@(book.CoverId)-M.jpg"
                         alt="" />
                </span>

                @*
                    The jacket again, upside down, as the floor sees it.

                    This used to be -webkit-box-reflect, which drew the reflection without a second
                    element — but it is a non-standard property Firefox has never implemented, and
                    mobile browsers drop it often enough that the deck arrived on a phone standing
                    on nothing. A flipped copy under a mask is plain CSS and works everywhere.

                    The objection to drawing each jacket twice was that it meant fetching each
                    image twice. It does not any more: the covers ship with the application, so the
                    second <img> is the same cached file and costs a decode, not a request.

                    aria-hidden, and no text worth reading: a screen reader announcing every title
                    twice is the accessible version of a smudge on the floor.
                *@
                <span class="cover cover--@(position % CoverTones) cover--mirror" aria-hidden="true">
                    <span class="cover__title">@book.Title</span>
                    <span class="cover__rule"></span>
                    <span class="cover__author">@book.Author</span>
                    <img class="cover__art" src="covers/@(book.CoverId)-M.jpg" alt="" />
                </span>
            </button>
        }
    </div>

    <p class="flow__caption" @key="Front.Title">
        <strong>@Front.Title</strong>
        <span>@Front.Author</span>
    </p>
</div>

@code {
    /// <summary>
    /// How long a book stays at the front. Long enough that the deck reads as something alive
    /// rather than something being scrolled at you, short enough that a reader who stops to look
    /// at it sees it move rather than having to wait for it.
    /// </summary>
    private static readonly TimeSpan Dwell = TimeSpan.FromSeconds(7);

    /// <summary>
    /// How far a finger travels before the deck turns one place. A little under half a jacket:
    /// far enough that a tap with a wobble in it is still a tap, close enough that a flick moves
    /// several books rather than politely turning one.
    /// </summary>
    private const double SwipeStepPx = 48;

    /// <summary>How many jacket designs the stylesheet draws.</summary>
    private const int CoverTones = 6;

    /// <summary>
    /// The books in the deck: long out of copyright, with Open Library's cover for each.
    ///
    /// The ids are written down rather than looked up. A welcome screen that has to search an API
    /// before it knows what to draw is a welcome screen that waits — and Open Library rate limits
    /// a run of searches, so the wait is not hypothetical. Fetching seventeen known images is a
    /// different thing from asking seventeen questions first.
    ///
    /// The jackets themselves are served from wwwroot/covers rather than from Open Library, and
    /// the ids survive only as the filenames, which is where each one came from. Fetching them
    /// live was measured at roughly two seconds apiece: covers.openlibrary.org answers most ids
    /// with a 302 to archive.org, which then pulls the jpeg out of a zip. Seventeen of those, on
    /// the screen a signed-out reader sees first and lands back on after signing out, routinely
    /// spent the whole cap below waiting. They are 312 KB together and they never change.
    ///
    /// Every title here has been checked to have a cover. That is the curation the drawn jackets
    /// underneath cannot do for us: one drawn jacket in a deck of photographed ones does not read
    /// as a considered fallback, it reads as a broken image. Anna Karenina was dropped for exactly
    /// this reason — Open Library has no cover for it.
    ///
    /// wwwroot/index.html prefetches these same covers while the runtime is still starting, so
    /// that by the time this renders they are already in the cache. Keep the two lists in step —
    /// an id only in one place costs that jacket its head start rather than breaking anything.
    /// </summary>
    private static readonly (string Title, string Author, int CoverId)[] Wall =
    [
        ("Frankenstein", "Mary Shelley", 12356249),
        ("Middlemarch", "George Eliot", 252882),
        ("Moby-Dick", "Herman Melville", 10544254),
        ("Jane Eyre", "Charlotte Brontë", 8235363),
        ("The Odyssey", "Homer", 12474938),
        ("Dracula", "Bram Stoker", 12216503),
        ("Persuasion", "Jane Austen", 12824691),
        ("Walden", "H. D. Thoreau", 11248037),
        // Not 9009316, whose cover art reads "THE TIME MASCHINE" in display type.
        ("The Time Machine", "H. G. Wells", 6907719),
        ("Wuthering Heights", "Emily Brontë", 12818862),
        ("Crime and Punishment", "F. Dostoevsky", 13116014),
        ("The Awakening", "Kate Chopin", 8750241),
        ("Great Expectations", "Charles Dickens", 13322313),
        ("Dubliners", "James Joyce", 8216412),
        ("The Iliad", "Homer", 12621988),
        ("North and South", "E. Gaskell", 8242253),
        ("The Turn of the Screw", "Henry James", 181493),
    ];

    /// <summary>
    /// How long the deck will wait for the last jacket before showing the ones it has.
    ///
    /// Short, because the jackets now ship with the application and come off the same CDN as the
    /// rest of it: they are either in cache or a few tens of milliseconds away, and anything
    /// longer than this is not a slow image but a broken one. It was six seconds while they were
    /// fetched from Open Library, and a reader signing out watched most of it.
    /// </summary>
    private static readonly TimeSpan LongestWaitForJackets = TimeSpan.FromMilliseconds(500);

    /// <summary>
    /// Raised once every jacket is in place. The welcome screen waits on this before showing
    /// itself, so the deck is never seen being built.
    /// </summary>
    [Parameter]
    public EventCallback Dressed { get; set; }

    private int _at;
    private bool _dressed;
    private System.Timers.Timer? _turn;

    /// <summary>Where the finger currently dragging the deck was last accounted for, if any.</summary>
    private double? _dragFrom;

    private (string Title, string Author, int CoverId) Front => Wall[_at];

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first)
        {
            return;
        }

        // index.html starts fetching the jackets while the runtime is still loading, which usually
        // has them here before this renders — but not always, and a deck that fills in one book at
        // a time in front of the reader looks like it is still being built. Held back until they
        // have all arrived, then shown as one picture. This comes before the stillness check
        // because that one can return early, and a deck that never dresses is worse than one that
        // never turns.
        await JS.InvokeVoidAsync(
            "readingTracker.coversSettled", ".flow__stage .cover__art", LongestWaitForJackets.TotalMilliseconds);

        _dressed = true;
        StateHasChanged();

        await Dressed.InvokeAsync();

        // A deck that turns on its own is exactly the kind of movement someone asks the platform
        // to stop. Asked once, after the first paint, so the deck is on screen either way and only
        // the turning waits on the answer.
        if (await JS.InvokeAsync<bool>("readingTracker.prefersStillness"))
        {
            return;
        }

        _turn = new System.Timers.Timer(Dwell.TotalMilliseconds);
        _turn.Elapsed += async (_, _) =>
        {
            // One place, either way. Always turning the same way makes a queue of books going past;
            // picking a side makes the deck look like it is being idly leafed through.
            var way = Random.Shared.Next(2) == 0 ? 1 : -1;

            Turn(way);
            await InvokeAsync(StateHasChanged);
        };
        _turn.Start();
    }

    /// <summary>
    /// Held still while the cursor is on the deck: a jacket that turns away as it is being looked
    /// at — or worse, as it is being aimed at — is a jacket nobody gets to look at. Stopping the
    /// timer rather than skipping a tick means the book on show keeps a full turn once the cursor
    /// leaves, instead of moving the moment it does.
    /// </summary>
    private void Hold() => _turn?.Stop();

    private void Release() => _turn?.Start();

    /// <summary>
    /// A finger has landed. The deck stops turning on its own for as long as it is being held —
    /// the same courtesy the cursor gets, and for the same reason: a jacket that turns away while
    /// it is being dragged at is a jacket nobody gets to choose.
    /// </summary>
    private void DragStart(TouchEventArgs touch)
    {
        if (touch.Touches.Length == 0)
        {
            return;
        }

        _turn?.Stop();
        _dragFrom = touch.Touches[0].ClientX;
    }

    /// <summary>
    /// Turns as the finger travels rather than waiting for it to lift, so the deck comes with the
    /// hand instead of catching up with it afterwards. Each whole step consumed moves the origin
    /// along with it, which is what lets one long drag walk through several books.
    /// </summary>
    private void DragMove(TouchEventArgs touch)
    {
        if (_dragFrom is not { } from || touch.Touches.Length == 0)
        {
            return;
        }

        var travelled = touch.Touches[0].ClientX - from;
        var steps = (int)(travelled / SwipeStepPx);

        if (steps == 0)
        {
            return;
        }

        // Dragging right brings the book on the left to the front, the way dragging a physical
        // stack of records would — the deck follows the hand, it is not pushed away by it.
        Turn(-steps);
        _dragFrom = from + steps * SwipeStepPx;

        StateHasChanged();
    }

    /// <summary>
    /// The finger has lifted. The wait starts again from here rather than resuming whatever was
    /// left of the last one, so a reader who has just chosen a book gets a full turn with it.
    /// </summary>
    private void DragEnd(TouchEventArgs touch)
    {
        _dragFrom = null;

        if (_turn is { } turning)
        {
            turning.Stop();
            turning.Start();
        }
    }

    /// <summary>
    /// Moves the deck by <paramref name="places"/>, wrapping either way round. Does not render:
    /// the timer has to marshal that onto the renderer's thread and the touch handlers are already
    /// on it, so whoever calls this says how.
    /// </summary>
    private void Turn(int places)
    {
        var length = Wall.Length;

        _at = ((_at + places) % length + length) % length;
    }

    /// <summary>
    /// Brings a book to the front, the way clicking one in the deck should. The wait starts again
    /// from here: having just chosen a book to look at, a reader should get the full minute with
    /// it rather than whatever was left of someone else's.
    /// </summary>
    private void Show(int position)
    {
        _at = position;

        if (_turn is { } turning)
        {
            turning.Stop();
            turning.Start();
        }
    }

    /// <summary>
    /// Where a book stands in the deck, worked out from how far round it is from the front.
    ///
    /// The distance is counted the short way round, so the deck turns by one place rather than
    /// every book stampeding back past the front when the front wraps to the start.
    /// </summary>
    private Slot Place(int position)
    {
        var raw = (position - _at + Wall.Length) % Wall.Length;
        var offset = raw > Wall.Length / 2 ? raw - Wall.Length : raw;
        var away = Math.Abs(offset);
        var lean = Math.Sign(offset);

        return new Slot(
            // The deck bunches as it recedes: the first neighbour steps a long way clear of the
            // book at the front, each one after it only a little further.
            X: lean * (0.72 + (away - 1) * 0.38),
            Depth: away * 2.8,
            // One angle for everyone behind the front, not one that grows: multiplying it would
            // turn the third book past the edge and show its back.
            Turn: lean * -64,
            Scale: 1 - Math.Min(away, 5) * 0.04,
            Fade: away <= 3 ? 1 : Math.Max(0, 1 - (away - 3) * 0.5),
            Layer: Wall.Length - away,
            // Anything still on screen is something a reader can aim at, and nothing else is: the
            // far side of the deck is drawn at zero opacity, and an invisible button is a trap.
            Lit: away <= 4);
    }

    /// <summary>
    /// A book's place in the deck, handed to the stylesheet as plain numbers so the CSS keeps the
    /// units and this keeps the arithmetic.
    /// </summary>
    private readonly record struct Slot(
        double X, double Depth, int Turn, double Scale, double Fade, int Layer, bool Lit)
    {
        /// <remarks>
        /// Formatted invariantly on purpose. This runs in the reader's browser under the reader's
        /// culture, and half of Europe writes 0,58 — which CSS reads as two values, or as nothing.
        /// </remarks>
        public string Style => string.Create(
            CultureInfo.InvariantCulture,
            $"--x:{X:0.###};--depth:{Depth:0.##};--turn:{Turn};--scale:{Scale:0.###};--fade:{Fade:0.##};--layer:{Layer}");
    }

    public void Dispose() => _turn?.Dispose();
}
