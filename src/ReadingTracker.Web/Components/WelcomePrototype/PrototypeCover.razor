@*
    PROTOTYPE — throwaway.

    One jacket, drawn. When the prototype is asked for real covers, Open Library's image is laid
    over the drawn one rather than instead of it: a cover that 404s, is throttled, or has not
    loaded yet shows the drawn jacket underneath, which is exactly the fallback the real thing
    would ship with. That is the comparison the covers question is actually asking for.
*@

<div class="p-cover p-cover--@Book.Tone">
    <span class="p-cover__title">@Book.Title</span>
    <span class="p-cover__rule"></span>
    <span class="p-cover__author">@Book.Author</span>

    @if (Real && Book.CoverUrl is { } cover)
    {
        <img class="p-cover__art" src="@cover" alt="" loading="lazy" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required PrototypeBook Book { get; set; }

    /// <summary>Whether to lay real cover art over the drawn jacket.</summary>
    [Parameter]
    public bool Real { get; set; }
}
