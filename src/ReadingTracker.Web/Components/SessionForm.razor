@using ReadingTracker.Web.Services

@*
    "I read from here to here." Used both to log a new stretch of reading and to correct one
    already recorded — the shape is identical, and Library takes the same body for both.

    Positions are entered in whatever method the reader tracks this book by. Library validates
    them properly (a session cannot end before it starts, or run past the end of the book) and
    the caller shows what it says; this form only stops obviously empty input from making the
    trip.
*@

<div class="panel">
    <div class="session-form">
        <div class="field">
            <label for="@($"from-{_id}")">From</label>
            <input id="@($"from-{_id}")" type="number" step="any" min="0" @bind="_start" />
            <span class="unit">@UnitLabel</span>
        </div>

        <div class="field">
            <label for="@($"to-{_id}")">To</label>
            <input id="@($"to-{_id}")" type="number" step="any" min="0" @bind="_end" />
            <span class="unit">@UnitLabel</span>
        </div>

        <div class="field">
            <label for="@($"on-{_id}")">On</label>
            <input id="@($"on-{_id}")" type="date" @bind="_occurredOn" />
        </div>

        <div class="field">
            <label for="@($"mins-{_id}")">For</label>
            <input id="@($"mins-{_id}")" type="number" min="1" @bind="_minutes" placeholder="optional" />
            <span class="unit">minutes</span>
        </div>
    </div>

    @if (_complaint is { } complaint)
    {
        <p class="entry__reasons" role="alert">@complaint</p>
    }

    <div class="session-form__actions">
        <button type="button" @onclick="SubmitAsync">@SubmitLabel</button>
        <button type="button" class="link-button" @onclick="OnCancel">Cancel</button>
    </div>
</div>

@code {
    /// <summary>The reader's TrackingMethod for this book, which is what positions are entered in.</summary>
    [Parameter, EditorRequired]
    public required string Unit { get; set; }

    [Parameter]
    public int? EffectivePageCount { get; set; }

    [Parameter, EditorRequired]
    public required string SubmitLabel { get; set; }

    /// <summary>The session being corrected, or null when logging a new one.</summary>
    [Parameter]
    public ReadingSessionView? Existing { get; set; }

    [Parameter]
    public EventCallback<NewSession> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];

    private decimal? _start;
    private decimal? _end;
    private DateTime? _occurredOn = DateTime.Today;
    private int? _minutes;
    private string? _complaint;

    private string UnitLabel => Unit == "Percentage" ? "%" : "page";

    protected override void OnParametersSet()
    {
        if (Existing is not { } session)
        {
            return;
        }

        // Correcting shows what is on the record in the reader's current method where Library
        // could convert it, and the values as logged where it could not.
        var (start, end) = session.Displayed is { } displayed
            ? (displayed.StartPosition, displayed.EndPosition)
            : (session.StartPosition, session.EndPosition);

        _start ??= start;
        _end ??= end;
        _occurredOn ??= session.OccurredAt.LocalDateTime.Date;
        _minutes ??= session.DurationMinutes;
    }

    private async Task SubmitAsync()
    {
        if (_start is not { } start || _end is not { } end)
        {
            _complaint = "Say where you read from and where you got to.";
            return;
        }

        _complaint = null;

        // Sent as a local-midnight instant with its offset, so "Tuesday" stays Tuesday rather
        // than sliding a day for readers west of UTC.
        var occurredAt = _occurredOn is { } on
            ? new DateTimeOffset(on.Date, TimeZoneInfo.Local.GetUtcOffset(on.Date))
            : (DateTimeOffset?)null;

        await OnSubmit.InvokeAsync(new NewSession(start, end, occurredAt, _minutes));
    }
}
