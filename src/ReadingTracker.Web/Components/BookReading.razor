@using ReadingTracker.Web.Services
@inherits EntryHost

@*
    The reading half of the Book page: everything the reader has done with this book and
    everything they can do to it — the same panels as the shelf card, wired to the same changes,
    with the room a page has that a card does not. The pace stripe heads it — its first figure
    is the card's figure, so the card's bar is not repeated here — the line saying where the
    e-reader last was comes under it; the log form opens under its button; Settings and Remove
    sit at the foot, where a page keeps the things done once.

    The status is a change this half owns but does not sit here: it stands at the right end of
    the page's head, level with the title, the way it does on the card. So the page hands the
    head over — the cover and the title — and this draws it with the status beside it, then the
    rest of the page's own content, then the reading.

    Unlike the card, the sessions are always wanted here — the page draws them — so they are
    loaded with the page and kept fresh through every change.
*@

<div class="book__head">
    @Head
    @* Where the book stands colours the select, and the page's own cover and title stay as
       they are, so the standing is scoped to the select alone. *@
    <div class="book__status @Standing">
        <StatusSelect Entry="Entry" Disabled="Working" OnPick="ChangeStatusAsync" />
    </div>
</div>

@ChildContent

<div class="reading @(Working ? "entry--working" : null) @Standing">
    <PaceStripe Entry="Entry" Sessions="Sessions" />

    @* Where the e-reader last was — the card says it under its bar; here the same line goes
       under the stripe, since the page has no bar of its own. See ProgressBar.razor. *@
    @if (!Finished && Entry.Bookmark is { } bookmark)
    {
        <p class="progress__device">
            On your device: <strong>@Figures.Trim(bookmark.Percent)%</strong>
            <span class="progress__device-when">@bookmark.ReportedAt.ToLocalTime().ToString("d MMM, HH:mm")</span>
        </p>
    }

    @if (Logging)
    {
        <div class="reading__actions">
            <LogButton Open="_panel == Panel.Log"
                       Starting="NotBegun"
                       Disabled="Working"
                       OnClick="() => Toggle(Panel.Log)" />
        </div>
    }

    @* Settings says them itself: on a phone its sheet covers this page, and a reason said only
       here would go unread. *@
    @if (Reasons.Count > 0 && !_correcting && _panel != Panel.Settings)
    {
        <ul class="entry__reasons" role="alert">
            @foreach (var reason in Reasons)
            {
                <li>@reason</li>
            }
        </ul>
    }

    @if (_panel == Panel.Log && Logging)
    {
        <SessionForm Unit="@Entry.TrackingMethod"
                     EffectivePageCount="Entry.EffectivePageCount"
                     Amount="Entry.AmountRead"
                     Title="@Entry.Book?.Title"
                     SubmitLabel="Log it"
                     OnSubmit="LogAsync"
                     OnCancel="Close" />
    }

    @if (_panel == Panel.Finished)
    {
        <FinishPrompt Title="@Title"
                      Disabled="Working"
                      OnFinish="FinishAsync"
                      OnNotYet="Close" />
    }

    <PagesChart Sessions="Sessions" />

    @*
        The Quotes, a taste of them: the first two the book holds, as the sheet's timeline draws
        them, and the way into the rest. Tapping one opens the sheet on it. A book with none has
        no section, since there is nothing here to open (ADR-0017: they come from a device).
    *@
    @if (QuoteCount > 0)
    {
        <section class="quotes-preview">
            <h2 class="group history__eyebrow">Quotes <span>· @QuoteCount</span></h2>
            @if (_preview is { Count: > 0 } preview)
            {
                <ol class="quotes__list">
                    @foreach (var quote in preview.Take(Previewed))
                    {
                        <li class="quotes__row" @key="quote.Id">
                            <span class="quotes__at">@Figures.Trim(quote.Percent)%</span>
                            <div class="quotes__body">
                                <button type="button" class="quotes__pick" aria-haspopup="dialog" @onclick="() => OpenQuotes(quote.Id)">
                                    <p class="quote__text">@quote.Passage.Trim()</p>
                                </button>
                            </div>
                        </li>
                    }
                </ol>
            }
            <button type="button"
                    class="link-button book__more quotes-preview__all"
                    aria-haspopup="dialog"
                    aria-expanded="@(_quotesOpen ? "true" : "false")"
                    @onclick="() => OpenQuotes(null)">
                @AllQuotes
            </button>
        </section>
    }

    <section class="history">
        <h2 class="group history__eyebrow">
            History
            @if (Sessions is { Count: > 0 } logged)
            {
                <span>· @Days(logged) · @(logged.Count == 1 ? "1 session" : $"{logged.Count} sessions")</span>
            }
        </h2>
        <SessionHistory Sessions="Sessions"
                        Unit="@Entry.TrackingMethod"
                        Reasons="Reasons"
                        OnCorrectDay="CorrectDayAsync"
                        OnDeleteDay="DeleteDayAsync"
                        OnEditingChanged="EditingChanged" />
    </section>

    <div class="reading__foot">
        <button type="button" class="link-button" @onclick="() => Toggle(Panel.Settings)" disabled="@Working">
            Settings
        </button>
        <button type="button" class="link-button link-button--danger" @onclick="() => Toggle(Panel.Remove)" disabled="@Working">
            Remove from shelf
        </button>
    </div>

    @if (_panel == Panel.Settings)
    {
        <EntrySettings Entry="Entry"
                       Disabled="Working"
                       Reasons="Reasons"
                       OnTrackingMethod="ChangeTrackingMethodAsync"
                       OnPageCount="SetPageCountAsync"
                       OnEdition="UseEditionAsync"
                       OnClose="Close"
                       Title="@Title" />
    }

    @if (_panel == Panel.Remove)
    {
        <RemovePrompt Title="@Title"
                      Disabled="Working"
                      OnRemove="RemoveAsync"
                      OnKeep="Close" />
    }
</div>

@* Beside the reading rather than in it: the reading fades while a change is in flight, and a
   sheet inside something faded is laid out against it instead of the screen. *@
@if (_quotesOpen)
{
    <QuoteSheet Entry="Entry"
                Opening="_opening"
                OnClose="CloseQuotes"
                OnCountChanged="KeepQuoteCount"
                OnSignedOut="OnSignedOut" />
}

@code {
    /// <summary>The page's head — the cover and the title — drawn here so the status can stand beside it.</summary>
    [Parameter, EditorRequired]
    public required RenderFragment Head { get; set; }

    /// <summary>The rest of the page's own content, between the head and the reading.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private enum Panel { None, Log, Settings, Remove, Finished }

    private Panel _panel = Panel.None;

    private bool _quotesOpen;

    /// <summary>
    /// How many Quotes are left after one was deleted in the sheet. A delete does not send the
    /// entry back, so the count is kept here until the next change that does.
    /// </summary>
    private int? _quotesLeft;

    private LibraryEntry? _countedFrom;

    private int QuoteCount => _quotesLeft ?? Entry.QuoteCount;

    /// <summary>How many Quotes the page shows before the sheet: enough to say what is there.</summary>
    private const int Previewed = 2;

    /// <summary>The book's Quotes, for the page's taste of them; null until they come, or if they could not.</summary>
    private IReadOnlyList<QuoteView>? _preview;

    /// <summary>The Quote the sheet opens on: the one tapped on the page, or none for the whole list.</summary>
    private Guid? _opening;

    /// <summary>The way into the sheet, said for what is in it: the rest, or the ones already shown.</summary>
    private string AllQuotes => QuoteCount switch
    {
        1 => "Open the quote",
        Previewed => "Open both quotes",
        var count => $"All {count} quotes",
    };

    /// <summary>Whether a correction form is open in the history, which then shows the reasons itself.</summary>
    private bool _correcting;

    /// <summary>Always: the page draws the sessions, so a change to them is always worth re-reading.</summary>
    protected override bool HistoryShowing => true;

    private string Title => Entry.Book?.Title ?? "this book";

    /// <summary>The classes that colour a book set aside or read to the end — see the card.</summary>
    private string? Standing => Parked ? "entry--parked" : Finished ? "entry--finished" : null;

    protected override Task OnInitializedAsync() => Task.WhenAll(LoadSessionsAsync(), LoadQuotesAsync());

    /// <summary>
    /// The page's taste of the Quotes, read when there are any to show. What could not be read
    /// leaves the heading and the way in, and the sheet says what went wrong when it is opened.
    /// </summary>
    private async Task LoadQuotesAsync()
    {
        if (QuoteCount == 0)
        {
            _preview = null;
            return;
        }

        var listed = await Library.GetQuotesAsync(Entry.Id, CancellationToken.None);
        _preview = listed.Ok ? listed.Value : null;
    }

    /// <summary>A fresh entry from Library carries its own count, which is the one to believe.</summary>
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_countedFrom, Entry))
        {
            _countedFrom = Entry;
            _quotesLeft = null;
        }
    }

    private void OpenQuotes(Guid? quote)
    {
        _opening = quote;
        _quotesOpen = true;
    }

    /// <summary>Closed, the sheet may have changed what the page shows of it: a note, a Quote gone.</summary>
    private async Task CloseQuotes()
    {
        _quotesOpen = false;
        await LoadQuotesAsync();
    }

    private void KeepQuoteCount(int left) => _quotesLeft = left;

    private void Toggle(Panel panel)
    {
        _panel = _panel == panel ? Panel.None : panel;
        ClearReasons();
    }

    private void Close()
    {
        _panel = Panel.None;
        ClearReasons();
    }

    private void EditingChanged(bool correcting)
    {
        _correcting = correcting;
        ClearReasons();
    }

    private static string Days(IReadOnlyList<ReadingSessionView> sessions)
    {
        var days = sessions.Select(session => ReaderDays.Of(session.OccurredAt, TimeZoneInfo.Local)).Distinct().Count();

        return days == 1 ? "1 day" : $"{days} days";
    }

    protected override void Logged() => Close();

    /// <summary>
    /// The prompt that asked has been answered; and a log form open on a book just set aside
    /// has nothing left to log against.
    /// </summary>
    protected override void StatusChanged(LibraryEntry entry)
    {
        if (_panel == Panel.Finished || (_panel == Panel.Log && entry.Status is not ("Reading" or "WantToRead")))
        {
            Close();
        }
    }

    protected override void ReachedEnd() => _panel = Panel.Finished;
}
