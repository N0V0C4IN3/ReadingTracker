@using ReadingTracker.Web.Services
@inherits EntryHost

@*
    One book on the reader's shelf, and everything they can do to it: change where it stands,
    record what they read, correct that record, say how long their edition is, take it off.

    Each panel is opened rather than shown at once. A shelf is read far more often than it is
    edited, and a card carrying every control for every book at all times is a wall rather than a
    shelf. The reader's own reading — the progress line — is the part that stays visible.

    The panels themselves, and the changes they ask for, are shared with the Book page: the
    panels are components, and the changes live in EntryHost, which this inherits.
*@

@*
    A book on hold or dropped is set aside, and looks it: the card goes to black and white — the
    jacket desaturated, the accent turned to grey — so on a shelf of everything the books actually
    in hand are the ones in colour.
*@
<article class="entry @(Working ? "entry--working" : null) @(Parked ? "entry--parked" : null) @(Finished ? "entry--finished" : null)" style="--at:@At">
    @* The cover and the title are the way to the book's own page; the rest of the card stays
       what it was, controls and all, so the link never gets in the way of a tap on them. *@
    <a class="entry__cover" href="@PageHref" tabindex="-1" aria-hidden="true">
        @if (Entry.Book?.CoverUrl is { } cover)
        {
            <img src="@cover" alt="" loading="lazy" />
        }
        else
        {
            @* Not an error: Catalog simply has no cover for some books, and a broken image icon
               would read as one. *@
            <div class="entry__cover-placeholder" aria-hidden="true">@Initial</div>
        }
    </a>

    @*
        A grid: the title and authors on the left of the first row and the progress figure on
        its right, the bar across the second, and everything after that full width. The figure
        is the card's headline number and sits where a headline number goes, not down among the
        controls — see ProgressBar.razor.
    *@
    <div class="entry__body">
        <div class="entry__head">
            <h3 class="entry__title"><a href="@PageHref">@(Entry.Book?.Title ?? "(catalog unreachable)")</a></h3>

            @if (Entry.Book is { Authors.Count: > 0 } book)
            {
                <p class="entry__authors">@string.Join(", ", book.Authors)</p>
            }
        </div>

        <ProgressBar Progress="Entry.Progress"
                     TrackingMethod="@Entry.TrackingMethod"
                     EffectivePageCount="Entry.EffectivePageCount"
                     Bookmark="Entry.Bookmark"
                     Finished="Finished"
                     FinishedOn="Entry.FinishedOn" />

        <StatusSelect Entry="Entry" Disabled="Working" OnPick="ChangeStatusAsync" />

        <div class="entry__actions">
            @if (Logging)
            {
                <button type="button"
                        class="button--log @(_panel == Panel.Log ? "button--log--open" : null)"
                        @onclick="() => Toggle(Panel.Log)"
                        disabled="@Working">
                    @if (_panel == Panel.Log)
                    {
                        <text>Cancel</text>
                    }
                    else
                    {
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M11.4 1.6l3 3L5.2 13.8 1.5 14.5l.7-3.7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                        <text>Log reading</text>
                    }
                </button>
            }
            <button type="button" class="link-button" @onclick="ToggleHistoryAsync" disabled="@Working">
                History
            </button>
            <button type="button" class="link-button" @onclick="() => Toggle(Panel.Settings)" disabled="@Working">
                Settings
            </button>
            <button type="button" class="link-button link-button--danger" @onclick="() => Toggle(Panel.Remove)" disabled="@Working">
                Remove
            </button>
        </div>

        @if (Reasons.Count > 0)
        {
            <ul class="entry__reasons" role="alert">
                @foreach (var reason in Reasons)
                {
                    <li>@reason</li>
                }
            </ul>
        }

        @if (_panel == Panel.Log && Logging)
        {
            <SessionForm Unit="@Entry.TrackingMethod"
                         SubmitLabel="Log it"
                         OnSubmit="LogAsync"
                         OnCancel="Close" />
        }

        @if (_panel == Panel.History)
        {
            <SessionHistory Sessions="Sessions"
                            Unit="@Entry.TrackingMethod"
                            OnCorrect="CorrectAsync"
                            OnDelete="DeleteSessionAsync"
                            OnEditingChanged="ClearReasons" />
        }

        @if (_panel == Panel.Settings)
        {
            <EntrySettings Entry="Entry"
                           Disabled="Working"
                           OnTrackingMethod="ChangeTrackingMethodAsync"
                           OnPageCount="SetPageCountAsync"
                           OnEdition="UseEditionAsync" />
        }

        @if (_panel == Panel.Finished)
        {
            <FinishPrompt Title="@(Entry.Book?.Title ?? "this book")"
                          Disabled="Working"
                          OnFinish="MarkFinishedAsync"
                          OnNotYet="Close" />
        }

        @if (_panel == Panel.Remove)
        {
            <RemovePrompt Title="@(Entry.Book?.Title ?? "this book")"
                          Disabled="Working"
                          OnRemove="RemoveAsync"
                          OnKeep="Close" />
        }
    </div>
</article>

@code {
    private enum Panel { None, Log, History, Settings, Remove, Finished }

    /// <summary>Where on the shelf this card sits, so it can arrive a beat after the one above.</summary>
    [Parameter]
    public int At { get; set; }

    private Panel _panel = Panel.None;

    /// <summary>The book's own page.</summary>
    private string PageHref => $"shelf/{Entry.Id}";

    protected override bool HistoryShowing => _panel == Panel.History;

    private string Initial => (Entry.Book?.Title ?? "?").Trim() is { Length: > 0 } title
        ? title[..1].ToUpperInvariant()
        : "?";

    private void Toggle(Panel panel)
    {
        _panel = _panel == panel ? Panel.None : panel;
        ClearReasons();
    }

    private void Close()
    {
        _panel = Panel.None;
        ClearReasons();
    }

    private async Task ToggleHistoryAsync()
    {
        if (_panel == Panel.History)
        {
            Close();
            return;
        }

        Toggle(Panel.History);
        await LoadSessionsAsync();
    }

    /// <summary>Their answer to the prompt a completed book raises, which is the same change
    /// the status control makes — the prompt only saves them going to find it.</summary>
    private Task MarkFinishedAsync() => ChangeStatusAsync("Finished");

    protected override void Logged() => Close();

    /// <summary>
    /// The prompt that asked has been answered; and a log form open on a book just set aside
    /// has nothing left to log against.
    /// </summary>
    protected override void StatusChanged(LibraryEntry entry)
    {
        if (_panel == Panel.Finished || (_panel == Panel.Log && entry.Status is not ("Reading" or "WantToRead")))
        {
            Close();
        }
    }

    protected override void ReachedEnd() => _panel = Panel.Finished;
}
