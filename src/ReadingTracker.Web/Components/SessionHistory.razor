@using ReadingTracker.Web.Services

@*
    The entry's ReadingSessions as days: one card per calendar day, latest first, naming the
    day and saying how many pages it came to. The day is what a reader remembers reading by,
    and an e-reader that reported four times in an evening is one evening's reading — so the
    logs themselves are not shown at all; a day is a number. Correct restates the day as one
    amount, and Delete takes the day off the record. Whether a correction took is the host's to
    say, so the form stays open on a refusal with the host's reasons beside it.

    The latest three days show at first, since a history is read from the top and a long one
    would push everything under it away. "Show more" unfolds the rest into a list that scrolls in
    its own box (in a phone's sheet, which scrolls already, the sheet carries them), and "Show
    less" folds them away again; the days past the fold (day--more) grow open and fold shut as
    they come and go, through js/motion.js. A day being corrected is never folded out of sight:
    a new day arriving above it unfolds the list, and "Show less" closes the form first.
*@

@if (Sessions is null)
{
    <p class="muted">Loading history…</p>
}
else if (Sessions.Count == 0)
{
    <p class="muted">Nothing logged yet. "Log reading" records your first stretch.</p>
}
else
{
    var today = DateOnly.FromDateTime(DateTime.Now);

    <ol class="days @(Scrolling ? "days--scrolling" : null)" id="@_listId">
        @foreach (var (day, at) in SessionDays.Shown(_days, _all).Select((day, at) => (day, at)))
        {
            <li class="day @(at >= SessionDays.ShownAtFirst ? "day--more" : null)" @key="day.Day">
                @if (_editing == day.Day)
                {
                    <div class="day__edit">
                        <p class="day__editing"><span class="day__name">@day.Name(today)</span> <span class="day__date">@day.Date(today)</span></p>
                        <SessionForm Unit="@Unit"
                                     SubmitLabel="Save"
                                     Existing="AsOne(day)"
                                     OnSubmit="@(stated => SaveAsync(day, stated))"
                                     OnCancel="CancelAsync" />
                        @if (Reasons.Count > 0)
                        {
                            <ul class="entry__reasons" role="alert">
                                @foreach (var reason in Reasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        }
                    </div>
                }
                else
                {
                    <div class="day__head">
                        <span class="day__name">@day.Name(today)</span>
                        <span class="day__date">@day.Date(today)</span>
                        <span class="day__total">@Total(day)</span>
                        <span class="day__ops">
                            <button type="button" class="link-button" @onclick="() => StartEditingAsync(day.Day)">Correct</button>
                            <button type="button" class="link-button link-button--danger" @onclick="() => OnDeleteDay(Ids(day))">Delete</button>
                        </span>
                    </div>
                }
            </li>
        }
    </ol>

    @if (SessionDays.Folded(_days))
    {
        <button type="button" class="link-button book__more days__all" aria-expanded="@(_all ? "true" : "false")" aria-controls="@_listId"
                @onclick="ToggleAllAsync">
            @(_all ? "Show less" : "Show more")
        </button>
    }
}

@code {
    /// <summary>The sessions to show; null while they are being fetched.</summary>
    [Parameter]
    public IReadOnlyList<ReadingSessionView>? Sessions { get; set; }

    /// <summary>The entry's TrackingMethod, which is the unit the correction form offers.</summary>
    [Parameter, EditorRequired]
    public required string Unit { get; set; }

    /// <summary>Restates a day — these sessions — as the one given. Answers whether it took; the form closes only when it did.</summary>
    [Parameter, EditorRequired]
    public required Func<IReadOnlyList<Guid>, NewSession, Task<bool>> OnCorrectDay { get; set; }

    /// <summary>Takes a day — these sessions — off the record.</summary>
    [Parameter, EditorRequired]
    public required Func<IReadOnlyList<Guid>, Task> OnDeleteDay { get; set; }

    /// <summary>
    /// The host's reasons for refusing the last change, shown beside the correction form while
    /// one is open — that is where the reader is looking.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> Reasons { get; set; } = [];

    /// <summary>Raised with whether a correction is now under way, so the host can clear what it was saying and know where to say it next.</summary>
    [Parameter]
    public EventCallback<bool> OnEditingChanged { get; set; }

    private readonly string _listId = $"days-{Guid.NewGuid():N}";

    /// <summary>The sessions as days, worked out once each time they arrive.</summary>
    private IReadOnlyList<SessionDay> _days = [];

    /// <summary>Whether every day is showing, rather than the latest few.</summary>
    private bool _all;

    /// <summary>Unfolded, with something that was folded: the list scrolls in its own box.</summary>
    private bool Scrolling => _all && SessionDays.Folded(_days);

    protected override void OnParametersSet()
    {
        _days = Sessions is null ? [] : SessionDays.Of(Sessions, TimeZoneInfo.Local);

        // Nothing left to fold (days were deleted): folded, so a fourth day arrives folded rather
        // than already open. A day being corrected that a new day has pushed past the fold:
        // unfolded, so the form being typed into is not hidden while it is open.
        if (!SessionDays.Folded(_days))
        {
            _all = false;
        }
        else if (_editing is { } editing && !SessionDays.Shown(_days, all: false).Any(day => day.Day == editing))
        {
            _all = true;
        }
    }

    /// <summary>A day being corrected that folding would hide is put back first, so no form is left open out of sight.</summary>
    private async Task ToggleAllAsync()
    {
        if (_all && _editing is { } editing && !SessionDays.Shown(_days, all: false).Any(day => day.Day == editing))
        {
            await CancelAsync();
        }

        _all = !_all;
    }

    private DateOnly? _editing;

    private static IReadOnlyList<Guid> Ids(SessionDay day) => day.Sessions.Select(session => session.Id).ToList();

    private async Task StartEditingAsync(DateOnly day)
    {
        _editing = day;
        await OnEditingChanged.InvokeAsync(true);
    }

    private async Task CancelAsync()
    {
        _editing = null;
        await OnEditingChanged.InvokeAsync(false);
    }

    private async Task SaveAsync(SessionDay day, NewSession stated)
    {
        if (await OnCorrectDay(Ids(day), stated))
        {
            _editing = null;
            await OnEditingChanged.InvokeAsync(false);
        }
    }

    /// <summary>What the day added up to: pages where they could be counted, percent where they could not.</summary>
    private static string Total(SessionDay day)
    {
        var amounts = new List<string>(2);

        if (day.Pages is { } pages)
        {
            amounts.Add($"{Figures.Trim(pages)} {(pages == 1m ? "page" : "pages")}");
        }

        if (day.Percent is { } percent)
        {
            amounts.Add($"{Figures.Trim(percent)}%");
        }

        return string.Join(" + ", amounts);
    }

    /// <summary>
    /// The day as one session, for the form to start from: its total in the reader's unit where
    /// that can be said, on its day, for as long as anybody said. A day whose total cannot be put
    /// in the reader's unit starts blank, and they say afresh.
    /// </summary>
    private ReadingSessionView AsOne(SessionDay day)
    {
        var total = Unit == "Pages" ? day.Pages : day.Pages is null ? day.Percent : null;
        var midnight = day.Day.ToDateTime(TimeOnly.MinValue);
        var start = new DateTimeOffset(midnight, TimeZoneInfo.Local.GetUtcOffset(midnight));

        return new ReadingSessionView(
            Guid.Empty,
            total ?? 0,
            Unit,
            "Reader",
            start,
            day.Minutes,
            total is { } amount ? new DisplayedAmount(amount, Unit) : null,
            day.Pages);
    }
}
