@using ReadingTracker.Web.Services

@*
    The entry's ReadingSessions as days: one card per calendar day, latest first, its header
    naming the day and saying what it added up to — pages where they can be counted, minutes
    where anybody said. The day is what a reader remembers reading by, and an e-reader that
    reported four times in an evening is one evening's reading, so the sessions themselves stay
    folded inside the card until asked for: the header says how many there are, and opening it
    lists them, latest first, each with its amount as it was logged, its time, its minutes, a
    mark when a device reported it, and Correct and Delete. Whether a correction took is the
    host's to say, so the form stays open on a refusal with the host's reasons beside it.

    Twenty days show at first; the rest are behind "Show all", since a history is read from
    the top.
*@

@if (Sessions is null)
{
    <p class="muted">Loading history…</p>
}
else if (Sessions.Count == 0)
{
    <p class="muted">Nothing logged yet. "Log reading" records your first stretch.</p>
}
else
{
    var today = DateOnly.FromDateTime(DateTime.Now);
    var days = SessionDays.Of(Sessions, EffectivePageCount, TimeZoneInfo.Local);

    <ol class="days">
        @foreach (var day in SessionDays.Shown(days, _all))
        {
            var open = _open.Contains(day.Day);

            <li class="day" @key="day.Day">
                <button type="button"
                        class="day__head @(open ? "day__head--open" : null)"
                        @onclick="() => ToggleAsync(day.Day)"
                        aria-expanded="@(open ? "true" : "false")">
                    <span class="day__name">@day.Name(today)</span>
                    <span class="day__date">@day.Date(today)</span>
                    <span class="day__total">@Total(day)</span>
                    <span class="day__count">@(day.Sessions.Count == 1 ? "1 log" : $"{day.Sessions.Count} logs")</span>
                </button>

                @if (open)
                {
                    <ul class="sessions">
                        @foreach (var session in day.Sessions)
                        {
                            <li class="session" @key="session.Id">
                                @if (_editing == session.Id)
                                {
                                    <SessionForm Unit="@Unit"
                                                 SubmitLabel="Save"
                                                 Existing="session"
                                                 OnSubmit="@(edited => SaveAsync(session.Id, edited))"
                                                 OnCancel="CancelAsync" />
                                    @if (Reasons.Count > 0)
                                    {
                                        <ul class="entry__reasons" role="alert">
                                            @foreach (var reason in Reasons)
                                            {
                                                <li>@reason</li>
                                            }
                                        </ul>
                                    }
                                }
                                else
                                {
                                    <span class="session__what">@Describe(session)</span>
                                    @if (TimeOf(session) is { } time)
                                    {
                                        <span class="session__when">@time</span>
                                    }
                                    @if (session.DurationMinutes is { } minutes)
                                    {
                                        <span class="session__how-long">@minutes min</span>
                                    }
                                    @if (session.Source == "Device")
                                    {
                                        @* Reported by an e-reader rather than typed in: worth knowing when a
                                           session looks like nothing the reader remembers logging. *@
                                        <span class="session__source" title="Reported by your device">device</span>
                                    }
                                    <button type="button" class="link-button" @onclick="() => StartEditingAsync(session.Id)">Correct</button>
                                    <button type="button" class="link-button link-button--danger" @onclick="() => OnDelete(session.Id)">Delete</button>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ol>

    @if (!_all && SessionDays.Folded(days))
    {
        <button type="button" class="link-button days__all" @onclick="() => _all = true">
            Show all @days.Count days
        </button>
    }
}

@code {
    /// <summary>The sessions to show; null while they are being fetched.</summary>
    [Parameter]
    public IReadOnlyList<ReadingSessionView>? Sessions { get; set; }

    /// <summary>The entry's TrackingMethod, which is the unit the correction form offers.</summary>
    [Parameter, EditorRequired]
    public required string Unit { get; set; }

    /// <summary>The entry's effective page count, which is what turns a day's percent into pages.</summary>
    [Parameter]
    public int? EffectivePageCount { get; set; }

    /// <summary>Corrects a session. Answers whether it took; the form closes only when it did.</summary>
    [Parameter, EditorRequired]
    public required Func<Guid, NewSession, Task<bool>> OnCorrect { get; set; }

    [Parameter, EditorRequired]
    public required Func<Guid, Task> OnDelete { get; set; }

    /// <summary>
    /// The host's reasons for refusing the last change, shown beside the correction form while
    /// one is open — that is where the reader is looking.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> Reasons { get; set; } = [];

    /// <summary>Raised with whether a correction is now under way, so the host can clear what it was saying and know where to say it next.</summary>
    [Parameter]
    public EventCallback<bool> OnEditingChanged { get; set; }

    private readonly HashSet<DateOnly> _open = [];

    private bool _all;

    private Guid? _editing;

    private async Task ToggleAsync(DateOnly day)
    {
        if (!_open.Remove(day))
        {
            _open.Add(day);
        }
        else if (_editing is not null)
        {
            // Closing a day closes a correction begun inside it.
            await CancelAsync();
        }
    }

    private async Task StartEditingAsync(Guid sessionId)
    {
        _editing = sessionId;
        await OnEditingChanged.InvokeAsync(true);
    }

    private async Task CancelAsync()
    {
        _editing = null;
        await OnEditingChanged.InvokeAsync(false);
    }

    private async Task SaveAsync(Guid sessionId, NewSession edited)
    {
        if (await OnCorrect(sessionId, edited))
        {
            _editing = null;
            await OnEditingChanged.InvokeAsync(false);
        }
    }

    /// <summary>What the day added up to: pages where they could be counted, percent where not, minutes where given.</summary>
    private static string Total(SessionDay day)
    {
        var amounts = new List<string>(2);

        if (day.Pages is { } pages)
        {
            amounts.Add($"{Figures.Trim(pages)} {(pages == 1m ? "page" : "pages")}");
        }

        if (day.Percent is { } percent)
        {
            amounts.Add($"{Figures.Trim(percent)}%");
        }

        var total = string.Join(" + ", amounts);

        return day.Minutes is { } minutes ? $"{total} · {minutes} min" : total;
    }

    /// <summary>
    /// The time of day, for a session that has one. A stretch logged by hand is dated to a day
    /// and stored at its midnight, and "00:00" would claim a time nobody gave.
    /// </summary>
    private static string? TimeOf(ReadingSessionView session)
    {
        var at = session.OccurredAt.ToLocalTime();

        return at.TimeOfDay == TimeSpan.Zero ? null : at.ToString("HH:mm");
    }

    /// <summary>The amount as it was logged — the day's header has already done the adding up in one unit.</summary>
    private static string Describe(ReadingSessionView session) =>
        session.Unit == "Percentage"
            ? $"{Figures.Trim(session.Amount)}%"
            : $"{Figures.Trim(session.Amount)} {(session.Amount == 1m ? "page" : "pages")}";
}
