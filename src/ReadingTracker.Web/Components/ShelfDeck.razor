@using ReadingTracker.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    The shelf on a phone held on its side: a cover flow, the way an iPod showed albums. Jackets
    only, one face-on in the middle and three turned away either side, the front one's title and
    author under it, and a tap on it opens the book. Under that, the shelves on a drum, turned the
    same way.

    The flow is the whole shelf in one run, shelf after shelf in the shelf's own order, so turning
    past the last book on one shelf brings up the first on the next, and the drum turns with it to
    say where it has got to. The drum is also a way there: a shelf chosen on it turns the flow to
    that shelf's first book.

    This decides which book is at the front, and each jacket's distance from it (--deck-off), from
    which the stylesheet works out where it stands. js/shelfDeck.js only reads the finger and the
    keys, and asks for a turn.
*@

<div class="deck" @ref="_root">
    <div class="deck__cards @(Entries is null ? "deck__cards--pending" : null)">
        @if (Entries is null)
        {
            @* The loading ghosts stand as the flow will: one face-on, a few turned away either side. *@
            @for (var off = -Drawn; off <= Drawn; off++)
            {
                <div class="deck__slot @(off == 0 ? "is-front" : null)" style="--deck-off:@off">
                    <div class="deck__jacket bone bone--cover"></div>
                </div>
            }
        }
        else if (Entries.Count == 0)
        {
            <p class="empty">@Empty</p>
        }
        else
        {
            @for (var at = Math.Max(0, _front - Drawn - 1); at <= Math.Min(Entries.Count - 1, _front + Drawn + 1); at++)
            {
                var entry = Entries[at];
                var off = at - _front;
                <div @key="entry.Id"
                     class="deck__slot @(off == 0 ? "is-front" : null) @(Math.Abs(off) > Drawn ? "is-far" : null) @(_arriving.Contains(entry.Id) ? "is-arriving" : null)"
                     style="--deck-off:@off"
                     data-off="@off">
                    @* Only the one at the front opens its book; a tap on any other turns it to the front. *@
                    <a class="deck__jacket" href="shelf/@entry.Id" tabindex="@(off == 0 ? 0 : -1)" aria-hidden="@(off != 0)" draggable="false">
                        @if (entry.Book?.CoverUrl is { } cover)
                        {
                            <img src="@cover" alt="@entry.Book.Title" draggable="false" />
                        }
                        else
                        {
                            <span class="deck__placeholder">@Initial(entry)</span>
                        }
                    </a>
                </div>
            }
        }
    </div>

    @if (Entries is { Count: > 0 } shown)
    {
        var front = shown[_front];
        <p class="deck__caption" aria-live="polite">
            <strong>@(front.Book?.Title ?? "A book")</strong>
            @if (front.Book is { Authors.Count: > 0 } book)
            {
                <span>@string.Join(", ", book.Authors)</span>
            }
        </p>
    }

    @if (Entries is { Count: > 1 })
    {
        @* The flow turned without a finger: by these, and by the arrow keys (shelfDeck.js). Never
           disabled at the ends: a button disabled under the focus drops it, and the keys with it. *@
        <div class="deck__steps">
            <button type="button" class="deck__step deck__step--back" aria-disabled="@(_front == 0)" @onclick="() => Turn(-1)">Previous book</button>
            <button type="button" class="deck__step deck__step--on" aria-disabled="@(_front == Entries.Count - 1)" @onclick="() => Turn(1)">Next book</button>
        </div>
    }

    @{
        @*
            Each shelf is placed by --off, its distance from the front book's. While a finger is on
            the drum shelfDeck.js adds how far it has moved (--drag, on the drum) and takes the
            transition off; let go, the drum runs on and comes to rest on a shelf, whose button it
            presses. A shelf with nothing on it cannot be pressed, and the drum goes on past it.
        *@
        var on = Math.Max(0, ShelfOrder.Statuses.ToList().IndexOf(Showing));
        <div class="deck__drum" role="group" aria-label="Go to a reading status">
            @foreach (var (status, at) in ShelfOrder.Statuses.Select((status, at) => (status, at)))
            {
                var count = Entries?.Count(entry => entry.Status == status);
                <button type="button"
                        class="deck__word @(at == on ? "is-on" : null) @($"import__tone--{status.ToLowerInvariant()}")"
                        style="--off:@(at - on)"
                        data-status="@status"
                        aria-pressed="@(at == on)"
                        disabled="@(count == 0)"
                        @onclick="() => TurnTo(status)">
                    <i class="status__dot" aria-hidden="true"></i>
                    @ReadingStatuses.Label(status)
                    @* Without a count while the shelf loads: it is not known yet. *@
                    @if (count is { } known)
                    {
                        <span>@known</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>The books in the flow, in order; null while the shelf is still loading.</summary>
    [Parameter]
    public IReadOnlyList<LibraryEntry>? Entries { get; set; }

    /// <summary>The shelf to open on, the first time the flow is dealt; null is the first book.</summary>
    [Parameter]
    public string? Start { get; set; }

    /// <summary>Raised when the flow has turned onto another shelf, so the page can remember it.</summary>
    [Parameter]
    public EventCallback<string> OnShelf { get; set; }

    /// <summary>What an empty flow says.</summary>
    [Parameter]
    public RenderFragment? Empty { get; set; }

    /// <summary>
    /// How far from the front a jacket can be seen. One further out is in the page but not drawn
    /// (is-far), waiting to turn into sight; the rest of the shelf is not in the page at all.
    /// </summary>
    private const int Drawn = 3;

    /// <summary>How long the jackets being dealt in take to arrive (app.css, deal).</summary>
    private const int DealtMs = 700;

    private ElementReference _root;
    private IJSObjectReference? _gestures;
    private DotNetObjectReference<ShelfDeck>? _self;
    private bool _disposed;

    /// <summary>The front book, by id, and where it stood in case it goes; null until the flow is dealt.</summary>
    private (Guid Id, int At)? _remembered;

    /// <summary>Where the front book stands now.</summary>
    private int _front;

    /// <summary>What the last parameters held, so a render of the page around the flow that changes nothing in it is not taken for a change.</summary>
    private IReadOnlyList<(Guid Id, string Status)>? _shown;

    /// <summary>Jackets being dealt in: the whole flow when it arrives, and those around a shelf the drum has turned to.</summary>
    private HashSet<Guid> _arriving = [];

    private int _deals;

    /// <summary>The shelf the front book is on: what the drum shows.</summary>
    private string Showing => Entries is { Count: > 0 } now ? now[_front].Status : Start ?? ShelfOrder.Statuses[0];

    protected override void OnParametersSet()
    {
        if (Entries is not { } now || (_shown is { } shown && Unchanged(now, shown)))
        {
            return;
        }

        var dealt = _shown is null;
        _shown = [.. now.Select(entry => (entry.Id, entry.Status))];

        // The front book stays the front book wherever the list puts it. If it has gone, the one
        // that takes its place does, rather than the flow going back to its first book.
        _front = 0;
        if (_remembered is { } front && now.Count > 0)
        {
            var still = IndexOf(now, front.Id);
            _front = still >= 0 ? still : Math.Min(front.At, now.Count - 1);
        }
        else if (Start is { } shelf)
        {
            _front = Math.Max(0, FirstOn(now, shelf));
        }

        Remember();
        if (dealt)
        {
            Deal(InReach(_front));
        }
    }

    private static bool Unchanged(IReadOnlyList<LibraryEntry> now, IReadOnlyList<(Guid Id, string Status)> shown)
    {
        if (now.Count != shown.Count)
        {
            return false;
        }

        for (var at = 0; at < now.Count; at++)
        {
            if (now[at].Id != shown[at].Id || now[at].Status != shown[at].Status)
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>Turns the flow by this many books (JS: a drag, or a tap either side of the front).</summary>
    [JSInvokable]
    public void Turn(int by)
    {
        if (Entries is { Count: > 0 } now)
        {
            MoveTo(Math.Clamp(_front + by, 0, now.Count - 1));
        }
    }

    /// <summary>Turns the flow to the first book on a shelf (the drum): a long way round, so the jackets there are dealt in rather than turned through.</summary>
    private void TurnTo(string status)
    {
        if (Entries is not null && FirstOn(Entries, status) is var to && to >= 0 && to != _front)
        {
            var had = InReach(_front).ToHashSet();
            Deal(InReach(to).Where(id => !had.Contains(id)));
            MoveTo(to);
        }
    }

    private void MoveTo(int to)
    {
        if (Entries is not { } now || to == _front)
        {
            return;
        }

        var shelf = now[_front].Status;
        _front = to;
        Remember();
        StateHasChanged();

        if (now[to].Status != shelf)
        {
            _ = OnShelf.InvokeAsync(now[to].Status);
        }
    }

    private void Deal(IEnumerable<Guid> jackets)
    {
        _arriving = [.. jackets];
        _ = DealtAsync(++_deals);
    }

    private async Task DealtAsync(int deal)
    {
        await Task.Delay(DealtMs);
        if (!_disposed && deal == _deals)
        {
            _arriving = [];
            StateHasChanged();
        }
    }

    private void Remember()
    {
        if (Entries is { Count: > 0 } now)
        {
            _remembered = (now[_front].Id, _front);
        }
    }

    /// <summary>The books in the page with this one at the front.</summary>
    private IEnumerable<Guid> InReach(int front)
    {
        var now = Entries ?? [];
        for (var at = Math.Max(0, front - Drawn - 1); at <= Math.Min(now.Count - 1, front + Drawn + 1); at++)
        {
            yield return now[at].Id;
        }
    }

    private static int FirstOn(IReadOnlyList<LibraryEntry> entries, string status)
    {
        for (var at = 0; at < entries.Count; at++)
        {
            if (entries[at].Status == status)
            {
                return at;
            }
        }

        return -1;
    }

    private static int IndexOf(IReadOnlyList<LibraryEntry> entries, Guid id)
    {
        for (var at = 0; at < entries.Count; at++)
        {
            if (entries[at].Id == id)
            {
                return at;
            }
        }

        return -1;
    }

    private static string Initial(LibraryEntry entry) =>
        (entry.Book?.Title ?? "?").Trim() is { Length: > 0 } title ? title[..1].ToUpperInvariant() : "?";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await using var js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shelfDeck.js");
            _gestures = await js.InvokeAsync<IJSObjectReference>("attach", _root, _self);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_gestures is not null)
            {
                await _gestures.InvokeVoidAsync("detach");
                await _gestures.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }
}
