@using ReadingTracker.Web.Services

@*
    What a book is about, and the edition line under it: the part of a book shown in full that
    comes from Catalog rather than from the shelf. Shared by the Book page and a search result's
    sheet, so the two say it alike.

    Catalog's part comes in after the rest is already standing, so the description is given a box
    that is there from the start with nothing in it, and opens to whatever Catalog said: what is
    under it is pushed down along with the box rather than jumping the height of the description
    in one frame. Catalog having nothing to say, or not being reachable, costs one line.

    Foldable, the description is the same height on every book: a fixed number of lines, cut with
    an ellipsis wherever the cut falls (the stylesheet does both). Read more unfolds the whole of
    it, and it folds back. Where there is room to scroll, as in a sheet, it is shown whole.
*@

<div class="book__reveal @(Answered ? "book__reveal--open" : null)">
    <div class="book__reveal-inner">
        @if (Book is { Paragraphs.Count: > 0 } described)
        {
            <div class="book__about @(Foldable && !_readingMore ? "book__about--folded" : null)">
                <div class="book__text">
                    @foreach (var paragraph in described.Paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                </div>
                @if (Foldable && Unfolds(described))
                {
                    <button type="button" class="link-button book__more" @onclick="() => _readingMore = !_readingMore">
                        @(_readingMore ? "Show less" : "Read more")
                    </button>
                }
            </div>
        }
        else if (Book is { DetailsUnavailable: true } || Problem is BookUnavailable.GatewayUnreachable)
        {
            <p class="hint book__note">The book's details could not be fetched just now. They will be here next time.</p>
        }
    </div>
</div>

<p class="book__edition">
    @foreach (var (fact, at) in Facts.Select((fact, at) => (fact, at)))
    {
        @if (at > 0)
        {
            <span class="book__dot" aria-hidden="true">·</span>
        }
        <span>@fact</span>
    }
    @if (Book is { ProviderUrl: { } providerUrl, ProviderName: { } providerName })
    {
        @if (Facts.Count > 0)
        {
            <span class="book__dot" aria-hidden="true">·</span>
        }
        <a href="@providerUrl" target="_blank" rel="noopener">@providerName ↗</a>
    }
</p>

@code {
    /// <summary>What Catalog said of the book; null until it has said it.</summary>
    [Parameter]
    public CatalogBook? Book { get; set; }

    /// <summary>Why Catalog could not say, when it could not.</summary>
    [Parameter]
    public BookUnavailable? Problem { get; set; }

    /// <summary>The edition line's facts, in the order a jacket flap says them; the provider's link follows.</summary>
    [Parameter]
    public IReadOnlyList<string> Facts { get; set; } = [];

    /// <summary>Whether the description folds to a fixed height behind Read more.</summary>
    [Parameter]
    public bool Foldable { get; set; }

    private bool _readingMore;

    private bool Answered => Book is not null || Problem is not null;

    /// <summary>
    /// Whether the description is long enough to be worth unfolding. The fold is a number of
    /// lines, which is not known here, so this is the length of text that fills it on a phone —
    /// on a wider screen a description a little over this fits and the button unfolds nothing,
    /// which is a small thing next to a button that is missing when it is needed.
    /// </summary>
    private static bool Unfolds(CatalogBook described) =>
        described.Paragraphs.Count > 1 || described.Paragraphs.Sum(paragraph => paragraph.Length) > 300;
}
