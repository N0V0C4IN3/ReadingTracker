@using ReadingTracker.Web.Services

@*
    How much of a book the reader has read. Library adds it up from their sessions every time it
    is asked for, never stores it, so this is always in step with the history behind it.

    Two pieces, laid out by the card rather than by this component — the wrapper is display:
    contents — so the figure can sit at the top of the card beside the title, where the number
    is the first thing read, and the bar can run the card's full width beneath. The number is
    the headline: for a reader, "42%" is the fact about a book that matters most after its name.

    A book with no sessions yet has no progress at all — not zero. Saying "0%" would claim
    something about the reader's reading that nothing has established, so the figure is a dash
    and the bar is empty.

    The Bookmark — where a device last said the reader is (ADR-0015) — is a different fact from
    the total and is shown as one: a mark on the track and a line beneath it, never the figure.
    Read-only, and absent until a device has said anything.

    A Finished book is past all of this: the status is the fact, whatever the sessions add up
    to, so the figure says Read and the bar is full. The sessions are still there in History.
*@

<div class="progress">
    @if (Finished)
    {
        <div class="progress__figure">
            <strong>Read</strong>
            <span>@(EffectivePageCount is { } total ? $"all {total} pages" : "cover to cover")</span>
        </div>
        <div class="progress__track" role="progressbar"
             aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"
             aria-label="Finished">
            <div class="progress__fill" style="width: 100%"></div>
        </div>
    }
    else if (Progress is not { } progress)
    {
        <div class="progress__figure progress__figure--none">
            <strong aria-hidden="true">—</strong>
            <span>Not started</span>
        </div>
        <div class="progress__track" aria-hidden="true"></div>
    }
    else if (progress.AmountRead is null)
    {
        @* Some of it logged in pages, some in percent, and no page count to add the two
           together with. The reader can fix it, and the Settings panel is where. *@
        <div class="progress__figure progress__figure--none">
            <strong aria-hidden="true">—</strong>
            <span>Set a page count to total this up</span>
        </div>
        <div class="progress__track" aria-hidden="true"></div>
    }
    else if (progress.PercentComplete is { } percent)
    {
        <div class="progress__figure">
            <strong>@percent%</strong>
            @* Tracking by percentage makes the bar's percentage and the reader's own total the
               same quantity, and "14%" over "13.5% read" reads as two facts that disagree. *@
            <span>@(progress.Unit == "Percentage" ? "read" : Read(progress))</span>
        </div>
        <div class="progress__track" role="progressbar"
             aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"
             aria-label="How much of this book you have read">
            <div class="progress__fill" style="width: @(percent)%"></div>
            @if (Bookmark is { } mark)
            {
                <div class="progress__bookmark" style="left: @(Trim(mark.Percent))%" aria-hidden="true"></div>
            }
        </div>
    }
    else
    {
        @* No page count anywhere, so a percentage cannot be worked out. The total is still
           worth showing: it is what the reader actually told us. *@
        <div class="progress__figure">
            <strong>@Trim(progress.AmountRead.Value)</strong>
            <span>pages read</span>
        </div>
        <div class="progress__track" aria-hidden="true"></div>
    }

    @if (Bookmark is { } bookmark)
    {
        <p class="progress__device">
            On your device: <strong>@Trim(bookmark.Percent)%</strong>
            <span class="progress__device-when">@bookmark.ReportedAt.ToLocalTime().ToString("d MMM, HH:mm")</span>
        </p>
    }
</div>

@code {
    [Parameter]
    public Progress? Progress { get; set; }

    [Parameter, EditorRequired]
    public required string TrackingMethod { get; set; }

    [Parameter]
    public int? EffectivePageCount { get; set; }

    [Parameter]
    public Bookmark? Bookmark { get; set; }

    [Parameter]
    public bool Finished { get; set; }

    /// <summary>
    /// What the reader has read, in words, under the percentage. Against a known length it is
    /// worth saying what the total is out of, and Library has already stopped that total at the
    /// whole book — so this says "208 of 208 pages" and never more, however much was logged.
    /// </summary>
    private string Read(Progress progress)
    {
        var amount = Trim(progress.AmountRead!.Value);

        return EffectivePageCount is { } total ? $"{amount} of {total} pages" : $"{amount} pages read";
    }

    private static string Trim(decimal value) =>
        value == decimal.Truncate(value) ? decimal.Truncate(value).ToString() : value.ToString("0.#");
}
