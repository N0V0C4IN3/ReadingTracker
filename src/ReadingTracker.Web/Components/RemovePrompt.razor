@* Are you sure, before a book and its history leave the shelf. The host removes; this only asks. *@

<div class="panel panel--danger">
    <p>Take <strong>@Title</strong> off your shelf? Its reading history goes with it.</p>
    <button type="button" class="danger" @onclick="OnRemove" disabled="@Disabled">Remove it</button>
    <button type="button" class="link-button" @onclick="OnKeep" disabled="@Disabled">Keep it</button>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback OnKeep { get; set; }
}
