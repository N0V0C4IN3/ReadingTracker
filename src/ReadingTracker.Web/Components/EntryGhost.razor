@*
    A card's shape before the shelf has come back: bones where the cover, title, authors, status
    and actions will be. For eyes only; whoever draws these says "loading" in words as well.
*@
<div class="entry entry--pending" style="--at:@At" aria-hidden="true">
    <div class="entry__cover">
        <div class="bone bone--cover"></div>
    </div>
    <div class="entry__body">
        <div class="bone bone--title"></div>
        <div class="bone bone--authors"></div>
        <div class="bone bone--status"></div>
        <div class="bone bone--actions"></div>
    </div>
</div>

@code {
    /// <summary>Its place in the row, so a row of them arrives a beat apart.</summary>
    [Parameter]
    public int At { get; set; }
}
