@using ReadingTracker.Web.Services
@inject GatewayCatalogClient Catalog
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    How the reader tracks this book and how long their copy is: the TrackingMethod, their own
    page count, and — the other way a count goes wrong — the edition itself, found by searching
    the library from here. Each change is the host's to make; this panel says what was asked.

    In the card it is a panel of three centred settings; on a phone it comes up from the foot of
    the screen over a scrim, the way the status list and the log form do. Finding an edition is a
    second view of the same panel rather than more of it: the library's search, in the main
    search's field and cards, with the results scrolling inside it, so a long list never pushes
    the page (or the sheet) past the screen. On a phone that view is the shelf search's own kind
    of sheet: the field at its foot, and a grip that drags it between a peek, a half and nearly
    full (js/sheet.js).
*@

<button type="button" class="sheet__scrim" tabindex="-1" aria-hidden="true" @onclick="OnClose"></button>

<div class="panel sheet settings @(_editionOpen ? "settings--finding" : null)" @ref="_panel" @onkeydown="CloseOnEscapeAsync">
    <p class="sheet__title">
        @(_editionOpen ? "Find your edition" : "Settings")
        @if (Title is { } title)
        {
            <span class="sheet__book">@title</span>
        }
    </p>

    @if (!_editionOpen)
    {
        <div class="settings__grid">
            <section class="settings__item">
                <label class="settings__label" for="@($"method-{Entry.Id}")">Track by</label>
                <TrackingSelect Id="@($"method-{Entry.Id}")" Value="@Entry.TrackingMethod" Disabled="Disabled" OnPick="PickTrackingMethodAsync" />
                @* Switching is a display-time conversion, never a rewrite of past sessions —
                   each keeps the unit it was logged in. Saying so stops it looking lossy. *@
                <p class="hint">Past sessions keep the unit they were logged in.</p>
            </section>

            <section class="settings__item">
                <label class="settings__label" for="@($"pages-{Entry.Id}")">Pages in your edition</label>
                <div class="settings__pages">
                    <input id="@($"pages-{Entry.Id}")" type="number" min="1" inputmode="numeric" @bind="_pageCount" @bind:event="oninput" disabled="@Disabled" />
                    <button type="button" @onclick="() => OnPageCount(_pageCount)" disabled="@(Disabled || _pageCount is not > 0 || _pageCount == CurrentPageCount)">Save</button>
                </div>
                <p class="hint">
                    @if (Entry.PageCountOverride is { } own)
                    {
                        <text>Yours: @own pages. </text>
                        <button type="button" class="link-button" @onclick="() => OnPageCount(null)" disabled="@Disabled">Use the catalog's count</button>
                    }
                    else if (Entry.Book?.TotalPages is { } catalogued)
                    {
                        <text>The catalog says @catalogued pages.</text>
                    }
                    else
                    {
                        <text>Nobody has a page count for this book, so percentages are unavailable until you set one.</text>
                    }
                </p>
            </section>

            @*
                The wrong edition is the other way a count goes wrong, and the fix for it is
                not a number but the right book. Pointing the entry at it keeps everything
                — status, sessions, the device linked to it — where re-adding would not.
            *@
            <section class="settings__item">
                <span class="settings__label">Edition</span>
                <button type="button" class="status__trigger settings__find" @onclick="OpenEditionSearchAsync" disabled="@Disabled">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    Find a different one
                </button>
                <p class="hint">Your status, sessions and device link stay.</p>
            </section>
        </div>

        @* The phone's way out: the Settings button that opened the sheet is under the scrim. *@
        <div class="sheet__foot">
            <button type="button" class="link-button" @onclick="OnClose">Done</button>
        </div>
    }
    else
    {
        <button type="button" class="search__grip" aria-label="Resize search results"></button>

        <button type="button" class="link-button settings__back" @onclick="CloseEditionSearch">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Settings
        </button>

        <div class="settings__search">
            <label class="search__field">
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                <input @ref="_queryBox" placeholder="Title, author or ISBN" aria-label="Find your edition"
                       @bind="_editionQuery" @bind:event="oninput" @onkeydown="SearchEditionOnEnterAsync"
                       disabled="@Disabled" />
                @if (_editionQuery.Length > 0)
                {
                    <button type="button" class="search__clear" aria-label="Clear search" @onclick="ClearQuery">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
                    </button>
                }
            </label>
            <button type="button" class="button--primary" @onclick="() => SearchEditionAsync(1)" disabled="@(Disabled || _editionBusy || string.IsNullOrWhiteSpace(_editionQuery))">
                @(_editionBusy ? "Searching…" : "Search")
            </button>
        </div>
        <p class="hint settings__note">Only the page count follows the new edition.</p>

        @if (_editionProblem is { } editionProblem)
        {
            <p class="hint hint--bad settings__note" role="alert">@editionProblem</p>
        }

        <div class="settings__results">
            @if (_editions is { } editions)
            {
                @if (_found.Count == 0)
                {
                    <p class="muted settings__none">Nothing in the library matches that.</p>
                }
                else
                {
                    <p class="group">In the library · @(editions.HasMore ? $"{_found.Count}+" : _found.Count.ToString())</p>

                    @* More results are added under the ones already there, rather than replacing
                       them: the list scrolls in its own window, so there is no page to turn. *@
                    <div class="lib-grid">
                        @foreach (var (found, at) in _found.Select((found, at) => (found, at)))
                        {
                            <div class="lib-card @(found.Id == Entry.BookId ? "lib-card--mine" : null)" @key="found.Id" style="--at:@(at - _firstNew)">
                                @if (found.CoverUrl is { } jacket)
                                {
                                    <img src="@jacket" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <div class="result__cover-placeholder" aria-hidden="true"></div>
                                }
                                <div class="lib-card__body">
                                    <strong>@found.Title</strong>
                                    @if (found.Authors.Count > 0)
                                    {
                                        <span>@string.Join(", ", found.Authors)</span>
                                    }
                                    <span class="lib-card__pages">@(found.TotalPages is { } length and > 0 ? $"{length} pages" : "length unknown")</span>
                                </div>
                                @if (found.Id == Entry.BookId)
                                {
                                    <span class="onshelf">This one</span>
                                }
                                else
                                {
                                    <button type="button" class="button--add" @onclick="() => UseEditionAsync(found)" disabled="@Disabled">
                                        Use this
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @if (editions.HasMore)
                    {
                        <div class="settings__more">
                            <button type="button" class="link-button" @onclick="() => SearchEditionAsync(editions.Page + 1)" disabled="@(Disabled || _editionBusy)">
                                @(_editionBusy ? "Searching…" : "More results")
                            </button>
                        </div>
                    }
                }
            }
            else if (_editionBusy)
            {
                <p class="muted settings__none">Searching the library…</p>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required LibraryEntry Entry { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The book, named at the head of the phone's sheet, which covers the card it came from.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Closes the panel: the scrim, Escape, or Done.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter, EditorRequired]
    public required Func<string, Task> OnTrackingMethod { get; set; }

    /// <summary>Sets the reader's own page count; null goes back to the catalog's.</summary>
    [Parameter, EditorRequired]
    public required Func<int?, Task> OnPageCount { get; set; }

    /// <summary>Points the entry at another Book. Answers whether it took; the search closes only when it did.</summary>
    [Parameter, EditorRequired]
    public required Func<Guid, Task<bool>> OnEdition { get; set; }

    private int? _pageCount;
    private int? _shownPageCount;

    private bool _editionOpen;
    private string _editionQuery = "";
    private bool _editionBusy;
    private BookSearchPage? _editions;
    private readonly List<BookSearchResult> _found = [];

    /// <summary>Where the page just added starts, so only its cards play the arrival.</summary>
    private int _firstNew;
    private string? _editionProblem;
    private bool _focusQuery;

    private ElementReference _panel;
    private ElementReference _queryBox;
    private IJSObjectReference? _lift;
    private IJSObjectReference? _sheet;

    /// <summary>Whether sheet.js has been asked to make the edition search draggable.</summary>
    private bool _draggable;

    private int? CurrentPageCount => Entry.PageCountOverride ?? Entry.Book?.TotalPages;

    /// <summary>
    /// The box follows the count the entry has, but only when that count changes: a re-render of
    /// the card mid-typing (the shelf refreshing, say) would otherwise put the old number back.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (CurrentPageCount != _shownPageCount)
        {
            _pageCount = _shownPageCount = CurrentPageCount;
        }
    }

    private Task PickTrackingMethodAsync(string method) => OnTrackingMethod(method);

    /// <summary>Escape steps back: out of the edition search to Settings, then out of Settings.</summary>
    private async Task CloseOnEscapeAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
        {
            return;
        }

        if (_editionOpen)
        {
            CloseEditionSearch();
        }
        else
        {
            await OnClose.InvokeAsync();
        }
    }


    /// <summary>
    /// Opens on a search already made for the book's own title — the likeliest way to find
    /// another printing of it — so the first thing shown is a list, not an empty box.
    /// </summary>
    private async Task OpenEditionSearchAsync()
    {
        _editionOpen = true;
        _editionQuery = Entry.Book?.Title ?? "";
        _editions = null;
        _found.Clear();
        _editionProblem = null;

        if (!string.IsNullOrWhiteSpace(_editionQuery))
        {
            await SearchEditionAsync(1);
        }
        else
        {
            _focusQuery = true;
        }
    }

    private void CloseEditionSearch()
    {
        _editionOpen = false;
        _editions = null;
        _found.Clear();
        _editionProblem = null;
    }

    private void ClearQuery()
    {
        _editionQuery = "";
        _editions = null;
        _found.Clear();
        _editionProblem = null;
        _focusQuery = true;
    }

    private async Task SearchEditionOnEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_editionQuery) && !_editionBusy)
        {
            await SearchEditionAsync(1);
        }
    }

    private async Task SearchEditionAsync(int page)
    {
        _editionBusy = true;
        _editionProblem = null;

        try
        {
            var (found, problem) = await Catalog.SearchAsync(_editionQuery, page, CancellationToken.None);

            if (found is not null)
            {
                if (page == 1)
                {
                    _found.Clear();
                }

                _firstNew = _found.Count;
                _found.AddRange(found.Results.Where(result => _found.All(shown => shown.Id != result.Id)));
                _editions = found;
            }
            else
            {
                _editionProblem = problem switch
                {
                    SearchUnavailable.NotSignedIn => "Your session has ended. Sign in again.",
                    SearchUnavailable.TooManyRequests => "That is a lot of searching — give the library a minute.",
                    _ => "The library could not be searched just now. Try again shortly.",
                };
            }
        }
        finally
        {
            _editionBusy = false;
        }
    }

    private async Task UseEditionAsync(BookSearchResult book)
    {
        if (await OnEdition(book.Id))
        {
            CloseEditionSearch();
        }
    }

    /// <summary>Kept above an iOS keyboard on a phone (js/liftSheet.js), as the log form is.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _lift = await JS.InvokeAsync<IJSObjectReference>("import", "./js/liftSheet.js");
            await _lift.InvokeVoidAsync("attach", _panel);
            _sheet = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sheet.js");
        }

        // The edition search is draggable while it is open, and the Settings view is not: it goes
        // back to the height of what it holds. sheet.js attaches nothing on a wide screen.
        if (_sheet is not null && _draggable != _editionOpen)
        {
            _draggable = _editionOpen;
            await (_draggable
                ? _sheet.InvokeVoidAsync("attach", _panel, "default")
                : _sheet.InvokeVoidAsync("detach", _panel));
        }

        if (_focusQuery && _editionOpen)
        {
            _focusQuery = false;
            await _queryBox.FocusAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_lift is null)
        {
            return;
        }

        try
        {
            await _lift.InvokeVoidAsync("detach", _panel);
            await _lift.DisposeAsync();

            if (_sheet is not null)
            {
                await _sheet.InvokeVoidAsync("detach", _panel, true);
                await _sheet.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page went with the circuit; there is nothing to let go of.
        }
    }
}
