{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_framework/*",
      "/_content/*",
      "/css/*",
      "/js/*",
      "/*.{png,ico,json,txt,xml,webmanifest}"
    ]
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".dat": "application/octet-stream",
    ".blat": "application/octet-stream",
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval' {inline-script-hashes}; style-src 'self' 'unsafe-inline'; img-src 'self' https:; connect-src 'self' {gateway} https://accounts.google.com https://www.googleapis.com; frame-src 'self' https://accounts.google.com; upgrade-insecure-requests"
  },
  "routes": [
    {
      "route": "/authentication/login-callback",
      "headers": { "X-Frame-Options": "SAMEORIGIN" }
    },
    {
      "route": "/_framework/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/appsettings*.json",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}
