{
  // Only ever fetched when this app is served in the Development environment: a WebAssembly app
  // asks for appsettings.{environment}.json, and the environment comes from the blazor-environment
  // header the host sends. `dotnet run` — and the Web container, which sets ASPNETCORE_ENVIRONMENT
  // explicitly — says Development; Azure Static Web Apps, serving the published files, does not.
  //
  // This is one of the two independent gates on dev sign-in. The other is the Gateway's, which
  // refuses to mint a token unless it is itself in Development with DevSignIn:Enabled set, so this
  // file alone cannot get a reader signed in anywhere. See ADR-0009.
  //
  // Set Enabled to false to put the real Google sign-in back for a local run.
  "DevSignIn": {
    "Enabled": true,
    "DefaultReaderId": "dev-reader"
  }
}
