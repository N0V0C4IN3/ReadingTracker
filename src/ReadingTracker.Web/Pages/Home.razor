@page "/"
@using Microsoft.Extensions.Options
@using ReadingTracker.Web.Components
@using ReadingTracker.Web.Services
@using ReadingTracker.Web.Layout
@inject GatewayLibraryClient Gateway
@inject GatewayCatalogClient Catalog
@inject IOptions<DevSignInOptions> DevSignIn
@inject NavigationManager Navigation
@inject ShelfMemory Memory
@inject IJSRuntime JS

<PageTitle>ReadingTracker</PageTitle>

<AuthorizeView>
    @*
        Until the answer to "is anyone signed in" is actually in, neither the shelf nor the welcome
        screen is the right thing to show. Without this the welcome screen renders first and is
        swapped out a moment later, so every signed-in reader is greeted by a flash of the page
        that asks them to sign in.
    *@
    <Authorizing>
        <Settling />
    </Authorizing>
    <Authorized>
        <section class="shelf @(Searching ? "shelf--searching" : null)">
            <div class="shelf__heading">
                <h1>Your shelf</h1>

                @if (_entries is { Count: > 0 } || _filter is not null)
                {
                    @* Dimmed and out of reach while a search is on: the search spans every status,
                       so a status filter would only fight it. Clearing the search brings them back. *@
                    <div class="filters @(Searching ? "filters--muted" : null)" role="group" aria-label="Filter by reading status">
                        @foreach (var (value, label) in Filters)
                        {
                            <button type="button"
                                    class="chip @(value == _filter ? "chip--on" : null)"
                                    data-status="@(value ?? "All")"
                                    aria-pressed="@(value == _filter)"
                                    disabled="@Searching"
                                    @onclick="() => FilterAsync(value)">
                                @label
                            </button>
                        }
                    </div>
                }
            </div>

            @*
                The quiet search row, under the tabs on a wide screen. One box does two jobs in
                order: it narrows your own shelf as you type, and searches the library on Enter. On
                a phone the field lives in the dock at the foot of the screen instead, and this is
                hidden — see the .search section below.
            *@
            <div class="search-row">
                <label class="search__field">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <input value="@_query" @oninput="OnQueryInput" maxlength="@MaxQueryLength" placeholder="Find a book — on your shelf, or in the library" aria-label="Find a book" @onkeydown="SearchOnEnterAsync" />
                    @if (_query.Length > 0)
                    {
                        <button type="button" class="search__clear" aria-label="Clear search" @onclick="ClearSearch">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
                        </button>
                    }
                </label>
                <button type="button" class="button--primary" @onclick="SearchAsync" disabled="@_searching">
                    @(_searching ? "Searching…" : "Search")
                </button>
            </div>
            @if (Searching)
            {
                <p class="hint-line">@Hint</p>
            }

            @if (_entries is { } entries)
            {
                @if (Searching)
                {
                    <p class="group">On your shelf <span>· @VisibleEntries.Count</span></p>
                }

                @if (VisibleEntries.Count == 0)
                {
                    <p class="empty">
                        @if (Searching)
                        {
                            <text>Nothing on your shelf matches “@_query.Trim()”.</text>
                        }
                        else if (_filter is null)
                        {
                            <text>Your shelf is empty. Search below to add your first book.</text>
                        }
                        else
                        {
                            <text>Nothing here with that status.</text>
                        }
                    </p>
                }
                else
                {
                    <div class="entries">
                        @*
                            The index rides along as At so the cards can arrive a beat apart, the
                            way search results do. Keyed by the entry, so a card that merely changes
                            keeps its element and does not arrive twice.
                        *@
                        @foreach (var (entry, at) in VisibleEntries.Select((entry, at) => (entry, at)))
                        {
                            @if (Grouped && (at == 0 || VisibleEntries[at - 1].Status != entry.Status))
                            {
                                <p class="group group--shelf" @key="entry.Status">@StatusLabel(entry.Status) <span>· @VisibleEntries.Count(other => other.Status == entry.Status)</span></p>
                            }
                            <ShelfEntry @key="entry.Id"
                                        Entry="entry"
                                        At="at"
                                        OnChanged="Replace"
                                        OnRemoved="@(() => RemoveAsync(entry.Id))"
                                        OnSignedOut="SignedOut" />
                        }
                    </div>
                }
            }
            else if (_problem == LibraryUnavailable.NotSignedIn)
            {
                <p class="notice">Your session has ended. <a href="authentication/login">Sign in again</a> to see your shelf.</p>
            }
            else if (_problem == LibraryUnavailable.GatewayUnreachable)
            {
                <p class="notice">ReadingTracker could not be reached just now. Try again shortly.</p>
            }
            else
            {
                @*
                    The shelf's own shape while Library is answering: three cards where the cards
                    will be, drawn in outline. A line of text saying "loading" leaves the reader
                    looking at an empty page that then lurches into a full one; a shelf that is
                    already there and fills in reads as one thing happening. Hidden from assistive
                    tech, which gets the sentence instead — the ghosts are for eyes only.
                *@
                <div class="entries entries--pending" aria-hidden="true">
                    @for (var at = 0; at < 3; at++)
                    {
                        <div class="entry entry--pending" style="--at:@at">
                            <div class="entry__cover">
                                <div class="bone bone--cover"></div>
                            </div>
                            <div class="entry__body">
                                <div class="bone bone--title"></div>
                                <div class="bone bone--authors"></div>
                                <div class="bone bone--status"></div>
                                <div class="bone bone--actions"></div>
                            </div>
                        </div>
                    }
                </div>
                <p class="visually-hidden" role="status">Loading your shelf</p>
            }
        </section>

        @*
            On a phone the search is behind the round button below until it is wanted, and this
            section is the dock that opens; on a wider screen it is a panel under the shelf and
            the button is not shown. Same markup either way — app.css decides which.
        *@
        @*
            The phone's search dock, and the wide screen's library results, are the same section.
            On a phone it is a bottom sheet: the field is its foot, the results scroll above, and
            the grip at its top drags it between a peek, a half and nearly full (see sheet.js). On
            a wide screen it is not a dock at all — the field under the tabs is used instead, this
            field and the grip are hidden, and what remains is the library's answer, in place under
            the shelf.
        *@
        @if (_searchOpen)
        {
            @* Phone only (app.css): a tap anywhere off the open dock closes it, as its ✕ does. *@
            <button type="button" class="search__scrim" tabindex="-1" aria-hidden="true" @onclick="ClearSearch"></button>
        }
        <section class="search @(_searchOpen ? "search--open" : null)" @ref="_dockEl">
            <button type="button" class="search__grip" aria-label="Resize search results"></button>

            <div class="search__found">
            @if (Searching && (_results is not null || _searching))
            {
                <p class="group">In the library@(_results is { } lib ? $" · {(lib.HasMore ? lib.Results.Count + "+" : lib.Results.Count.ToString())}" : "")</p>
            }
            @if (_results is { } found)
            {
                @if (found.Results.Count == 0)
                {
                    <p class="muted">
                        @(found.Page > 1 ? "Nothing more on this page." : "No books in the library matched your search.")
                    </p>

                    @if (!_addingByHand)
                    {
                        <p>
                            <button type="button" class="button--primary" @onclick="StartAddingByHand">
                                Add it by hand
                            </button>
                        </p>
                    }
                }
                else
                {
                    <div class="lib-grid">
                        @*
                            Keyed by the book so a new search builds new cards rather than rewriting
                            the old ones in place — which is what lets the arrival animation play
                            again. A book already on the shelf says so where its Add button would be.
                        *@
                        @foreach (var (book, at) in found.Results.Select((book, at) => (book, at)))
                        {
                            <div class="lib-card @(OnShelf(book.Id) ? "lib-card--mine" : null)" @key="book.Id" style="--at:@at">
                                @if (book.CoverUrl is { } cover)
                                {
                                    <img src="@cover" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <div class="result__cover-placeholder" aria-hidden="true"></div>
                                }

                                <div class="lib-card__body">
                                    <strong>@book.Title</strong>
                                    @if (book.Authors.Count > 0)
                                    {
                                        <span>@string.Join(", ", book.Authors)</span>
                                    }
                                    @if (book.TotalPages is { } pages)
                                    {
                                        <span class="lib-card__pages">@pages pages</span>
                                    }
                                </div>

                                @if (OnShelf(book.Id))
                                {
                                    <span class="onshelf">On your shelf</span>
                                }
                                else
                                {
                                    <button type="button"
                                            class="button--add"
                                            @onclick="() => AddToLibraryAsync(book.Id)"
                                            disabled="@(_adding == book.Id)">
                                        @(_adding == book.Id ? "Adding…" : "Add to shelf")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @* Only worth showing once there is somewhere to go: a single page of results
                   needs no way to leave it. *@
                @if (found.Page > 1 || found.HasMore)
                {
                    <nav class="pager" aria-label="Search result pages">
                        <button type="button"
                                disabled="@(found.Page <= 1 || _searching)"
                                @onclick="() => ShowPageAsync(found.Page - 1)">
                            Previous
                        </button>

                        <span class="muted">Page @(found.Page)</span>

                        <button type="button"
                                disabled="@(!found.HasMore || _searching)"
                                @onclick="() => ShowPageAsync(found.Page + 1)">
                            Next
                        </button>
                    </nav>
                }
            }
            else if (_searchProblem == SearchUnavailable.ProvidersUnavailable)
            {
                <p class="notice">Book search is temporarily unavailable. Try again shortly.</p>
            }
            else if (_searchProblem == SearchUnavailable.NotSignedIn)
            {
                <p class="notice">Your session has ended. <a href="authentication/login">Sign in again</a> to search.</p>
            }
            else if (_searchProblem == SearchUnavailable.GatewayUnreachable)
            {
                <p class="notice">ReadingTracker could not be reached just now. Try again shortly.</p>
            }
            else if (_searchProblem == SearchUnavailable.Refused)
            {
                <p class="notice">That search could not be run. Try fewer words, or an earlier page.</p>
            }
            else if (_searchProblem == SearchUnavailable.TooManyRequests)
            {
                <p class="notice">You are searching faster than the library can keep up with. Give it a minute.</p>
            }
            else if (Searching && !_addingByHand)
            {
                @* Typing has only ever narrowed the shelf; the library is a request, and this is
                   where it is offered rather than fired on every keystroke into two providers. *@
                <div class="library-offer">
                    @if (VisibleEntries.Count == 0)
                    {
                        <p>Not on your shelf yet.</p>
                    }
                    <button type="button" class="button--primary button--large" @onclick="SearchAsync" disabled="@_searching">
                        @(_searching ? "Searching…" : $"Search the library for “{_query.Trim()}”")
                    </button>
                </div>
            }

            @if (_addingByHand)
            {
                <div class="panel by-hand">
                    <h3>Add a book by hand</h3>
                    <p class="hint">Only the title and author are needed. The rest is whatever you know.</p>

                    <div class="field">
                        <label for="by-hand-title">Title</label>
                        <input id="by-hand-title" @bind="_newTitle" @bind:event="oninput" />
                        @foreach (var message in Rejected("Title"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-authors">Author(s)</label>
                        <input id="by-hand-authors" @bind="_newAuthors" @bind:event="oninput" />
                        <p class="hint">Separate more than one with a comma.</p>
                        @foreach (var message in Rejected("Authors"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-isbn">ISBN</label>
                        <input id="by-hand-isbn" @bind="_newIsbn" @bind:event="oninput" />
                        @foreach (var message in Rejected("Isbn"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-cover">Cover URL</label>
                        <input id="by-hand-cover" @bind="_newCoverUrl" @bind:event="oninput" />
                        @foreach (var message in Rejected("CoverUrl"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-pages">Pages</label>
                        <input id="by-hand-pages" type="number" min="1" @bind="_newTotalPages" />
                        @foreach (var message in Rejected("TotalPages"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    @if (_creation?.Problem == BookCreationProblem.IsbnAlreadyInCatalog)
                    {
                        <p class="notice notice--bad">
                            That ISBN is already in the catalog. Search for it by ISBN and add it from the results.
                        </p>
                    }
                    else if (_creation?.Problem == BookCreationProblem.NotSignedIn)
                    {
                        <p class="notice notice--bad">
                            Your session has ended. <a href="authentication/login">Sign in again</a> to add books.
                        </p>
                    }
                    else if (_creation?.Problem == BookCreationProblem.GatewayUnreachable)
                    {
                        <p class="notice notice--bad">ReadingTracker could not be reached just now. Try again shortly.</p>
                    }
                    else if (_creation?.Problem == BookCreationProblem.TooManyRequests)
                    {
                        <p class="notice notice--bad">That is a lot of books in a short time. Give it a minute, then add the next.</p>
                    }

                    <div class="session-form__actions">
                        <button type="button" class="button--primary" @onclick="AddByHandAsync" disabled="@_creating">
                            @(_creating ? "Adding…" : "Add to shelf")
                        </button>
                        <button type="button" class="link-button" @onclick="StopAddingByHand" disabled="@_creating">
                            Cancel
                        </button>
                    </div>
                </div>
            }

            @if (_addProblem == AddToLibraryProblem.AlreadyInLibrary)
            {
                <p class="notice">You already have that book in your library.</p>
            }
            else if (_addProblem == AddToLibraryProblem.NotSignedIn)
            {
                <p class="notice">Your session has ended. <a href="authentication/login">Sign in again</a> to add books.</p>
            }
            @if (_addProblem == AddToLibraryProblem.GatewayUnreachable)
            {
                <p class="notice">ReadingTracker could not be reached just now. Try again shortly.</p>
            }
            </div>

            @* The dock's foot on a phone; hidden on a wide screen, where the row under the tabs is
               the field. Bound to the same query, so the two are one box wherever it is shown. *@
            <div class="search__inputs">
                <label class="search__field">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <input @ref="_queryBox" value="@_query" @oninput="OnQueryInput" maxlength="@MaxQueryLength" placeholder="Find a book" aria-label="Find a book" @onkeydown="SearchOnEnterAsync" />
                    @if (_query.Length > 0)
                    {
                        <button type="button" class="search__clear" aria-label="Clear search" @onclick="ClearSearch">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
                        </button>
                    }
                </label>
                <button type="button" class="button--primary" @onclick="SearchAsync" disabled="@_searching">
                    @(_searching ? "Searching…" : "Search")
                </button>
            </div>
        </section>

        @if (!_searchOpen)
        {
            @* Phone only (app.css): a round + at the bottom right, where a thumb already is. The
               keyboard is raised by sheet.js inside the tap itself — see armOpener — and this
               handler records that the dock is open. *@
            <button type="button" class="search__fab" aria-label="Find a book" @ref="_fabEl" @onclick="OpenSearch">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </button>
        }
    </Authorized>
    <NotAuthorized>
        @*
            The one screen with no reader behind it, so there is nothing of theirs to show. It
            shows books instead: a deck of jackets under the greeting, over drawn ones, because a
            welcome screen that waits on a cover service is a welcome screen that sometimes greets
            people with nothing.

            The jackets are fetched while the runtime is still starting, but on a cold visit they
            can still be a moment behind it. Rather than show the screen and let it finish dressing
            in front of the reader, the loading animation stays up for that moment too: the last
            half second of the wait belongs to the wait, not to the page.

            The screen underneath is built and painted the whole time — it is a curtain over a
            finished set, not a screen being assembled. That is what lets the two cross-fade
            instead of one replacing the other: there is nothing to swap in at the end, only
            something to take away.
        *@
        <div class="welcome @(_welcomeDressed ? "welcome--shown" : null)">
            <div class="welcome__curtain @(_welcomeDressed ? "welcome__curtain--lifted" : null)"
                 aria-hidden="@_welcomeDressed">
                <Settling />
            </div>

        @*
            The way in is a card: the same glass, edge and shadow as a book on the shelf, with the
            greeting, the name, the line and the button inside it, and the deck below it on the
            open page. Signing in then puts more cards on the same page, rather than changing the
            scene — the poster this used to be was painted in nothing the shelf is made of.
        *@
        <section class="hero">
            <div class="hero__card">
                <p class="hero__greeting">@Greeting</p>
                <h1 class="hero__title">ReadingTracker</h1>
                <p class="hero__pitch">Track what you are reading, and how far through it you are.</p>

                <div class="hero__actions">
                    @if (DevSignIn.Value.Enabled)
                    {
                        <DevSignInForm />
                    }
                    else
                    {
                        <button type="button" class="button--primary button--large" @onclick="SignIn">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 6.6v2.9h4.1c-.2 1.1-1.3 3.1-4.1 3.1a4.6 4.6 0 0 1 0-9.2c1.4 0 2.3.6 2.8 1.1l2-1.9A7.5 7.5 0 0 0 8 .5a7.5 7.5 0 1 0 0 15c4.3 0 7.2-3 7.2-7.3 0-.5 0-.9-.1-1.6z" fill="currentColor" /></svg>
                            Sign in with Google
                        </button>
                    }
                </div>
            </div>

            <CoverFlow Dressed="ShowWelcome" />
        </section>

        @*
            Under the way in, not a second pitch — the card has said what this is — but a line
            someone once said about reading, a different one each visit.
        *@
        <section class="pitch">
            <blockquote class="quote">
                <p class="quote__text">@_quote.Text</p>
                <footer class="quote__author"><cite>@_quote.Author</cite></footer>
            </blockquote>
        </section>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Whether the welcome screen's jackets are in place. Until they are, the screen is behind the
    /// loading curtain — built, painted and waiting, rather than held back from rendering. The
    /// deck has to be in the page for its covers to be fetched at all.
    /// </summary>
    private bool _welcomeDressed;

    private void ShowWelcome() => _welcomeDressed = true;

    /// <summary>Drawn once per visit, so the words do not change under a reader's eyes.</summary>
    private readonly Quote _quote = Quotes.Pick(Random.Shared);

    /// <summary>The reader's own clock: this runs in their browser, so it is their time of day.</summary>
    private static string Greeting => DateTime.Now.Hour switch
    {
        < 5 => "Still awake",
        < 12 => "Good morning",
        < 18 => "Good afternoon",
        _ => "Good evening",
    };

    /// <summary>Null is "everything"; the rest are the ReadingStatus values Library accepts.</summary>
    private static readonly (string? Value, string Label)[] Filters =
    [
        (null, "All"),
        ("Reading", "Reading"),
        ("WantToRead", "Want to read"),
        ("Finished", "Finished"),
        ("OnHold", "On hold"),
        ("Dropped", "Dropped"),
    ];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IReadOnlyList<LibraryEntry>? _entries;
    private LibraryUnavailable? _problem;

    /// <summary>
    /// Which status the shelf is narrowed to; null is everything. Opens on Reading — the books in
    /// hand are what a reader comes back for — unless there are none, in which case it opens on
    /// everything: see OnParametersSetAsync.
    /// </summary>
    private string? _filter = OpensOn;

    private const string OpensOn = "Reading";

    /// <summary>Whether a search is on — anything in the box narrows the shelf and offers the library.</summary>
    private bool Searching => !string.IsNullOrWhiteSpace(_query);

    /// <summary>
    /// Whether the shelf shows its status groups under their own headings: on the All tab, at
    /// rest. A tab is one status already, and a search cuts across them all.
    /// </summary>
    private bool Grouped => _filter is null && !Searching;

    private static string StatusLabel(string status) =>
        Filters.FirstOrDefault(filter => filter.Value == status).Label ?? status;

    /// <summary>
    /// The shelf under the current status tab (client-side, so switching tabs is instant). The
    /// whole shelf is grouped by status, Reading at the top and Dropped at the bottom; a tab is
    /// one of those groups on its own, in the same order within.
    /// </summary>
    private IReadOnlyList<LibraryEntry> StatusFiltered =>
        _entries is null ? [] :
        ShelfOrder.ByStatus(_filter is null ? _entries : [.. _entries.Where(entry => entry.Status == _filter)]);

    /// <summary>
    /// What the shelf shows: the current tab at rest, or — while searching — every book whose
    /// title, author or ISBN contains the query, across every status. The search is what a reader
    /// came to do, so it wins over the tab.
    /// </summary>
    private IReadOnlyList<LibraryEntry> VisibleEntries
    {
        get
        {
            if (_entries is null)
            {
                return [];
            }

            if (!Searching)
            {
                return StatusFiltered;
            }

            var q = _query.Trim();

            return _entries.Where(entry => MatchesQuery(entry, q)).ToArray();
        }
    }

    private static bool MatchesQuery(LibraryEntry entry, string q)
    {
        if (entry.Book is not { } book)
        {
            return false;
        }

        if (book.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
            || book.Authors.Any(author => author.Contains(q, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        // An ISBN typed with or without its hyphens should still find the book it belongs to.
        var bare = q.Replace("-", "").Replace(" ", "");

        return bare.Length > 0
            && book.Isbn is { } isbn
            && isbn.Replace("-", "").Contains(bare, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Whether a book the library found is already on the shelf, so it offers no Add.</summary>
    private bool OnShelf(Guid bookId) => _entries?.Any(entry => entry.BookId == bookId) ?? false;

    /// <summary>The line under the field while searching: what is on the shelf, and where the library stands.</summary>
    private string Hint
    {
        get
        {
            var shelf = $"{VisibleEntries.Count} on your shelf";

            if (_results is { } found)
            {
                var count = found.HasMore ? $"{found.Results.Count}+" : found.Results.Count.ToString();

                return $"{shelf} · {count} in the library";
            }

            return $"{shelf} · press Enter to search the library";
        }
    }

    private string _query = "";

    /// <summary>
    /// The most Catalog will search for, so the box stops where Catalog would refuse rather
    /// than letting a reader type past it and be told afterwards. KEEP IN STEP with Catalog's
    /// SearchWindow.MaxQueryLength: this application does not reference Catalog's code.
    /// </summary>
    private const int MaxQueryLength = 200;

    /// <summary>
    /// What was actually searched for, which is not the same thing as what is in the box now.
    /// Paging re-runs this rather than whatever the reader has since typed, so pressing Next
    /// never quietly changes the query underneath them.
    /// </summary>
    private string? _searched;

    private BookSearchPage? _results;
    private SearchUnavailable? _searchProblem;
    private AddToLibraryProblem? _addProblem;
    private bool _searching;
    private Guid? _adding;

    private bool _addingByHand;
    private string _newTitle = "";
    private string _newAuthors = "";
    private string _newIsbn = "";
    private string _newCoverUrl = "";
    private int? _newTotalPages;
    private bool _creating;

    /// <summary>What Catalog said the last time this form was submitted, field by field.</summary>
    private BookCreation? _creation;

    /// <summary>Whose shelf is on screen, so a re-render is not mistaken for a change of reader.</summary>
    private string? _shelfBelongsTo;

    // Not OnInitializedAsync: signing in does not always reload the page. Google's does, because it
    // is a redirect out and back, but dev sign-in (ADR-0009) happens in place — so a page that only
    // ever fetched on initialisation would sit on "Loading your shelf…" until the reader refreshed
    // by hand. Reacting to the cascaded authentication state instead covers both.
    protected override async Task OnParametersSetAsync()
    {
        var state = AuthenticationState is null ? null : await AuthenticationState;

        var reader = state?.User.Identity?.IsAuthenticated is true
            ? state.User.FindFirst("sub")?.Value ?? state.User.Identity.Name
            : null;

        if (reader == _shelfBelongsTo)
        {
            return;
        }

        // The shelf remembers the tab it was left on for whoever left it there, and nobody else.
        if (_shelfBelongsTo is not null && reader != _shelfBelongsTo)
        {
            Memory.Forget();
        }

        _shelfBelongsTo = reader;

        // One reader's results must never be left on screen for the next one.
        _entries = null;
        _problem = null;
        _results = null;
        _searched = null;
        _searchProblem = null;
        _addProblem = null;
        _filter = Memory.Remembers ? Memory.Tab : OpensOn;
        StopAddingByHand();

        // Fetching before we know there is a reader would send the Gateway a request with no
        // token on every anonymous page load — harmless, since it just gets a 401 back, but
        // pointless network traffic for a page that has already decided not to show it.
        if (reader is null)
        {
            return;
        }

        await LoadShelfAsync();

        // Nothing on the go — a new reader, or one between books — and the shelf opens on
        // everything instead. An empty Reading tab is a poor first sight of a shelf with books on
        // it, and a worse one of a shelf with none: the "add your first book" line lives on All.
        // The whole shelf is already here, so this is a look at it rather than a second fetch.
        // A tab the reader chose is theirs, though, empty or not.
        if (!Memory.Remembers && StatusFiltered.Count == 0)
        {
            _filter = null;
        }
    }

    private async Task LoadShelfAsync()
    {
        (_entries, _problem) = await Gateway.GetEntriesAsync(null, CancellationToken.None);
        Memory.Keep(_entries);
    }

    /// <summary>
    /// Switching tabs no longer fetches: the whole shelf is already here, so the status filter is
    /// applied where the cards are read (StatusFiltered). Instant, and off-limits while searching.
    /// </summary>
    private void FilterAsync(string? status)
    {
        _filter = status;
        Memory.Remember(status);
    }

    /// <summary>
    /// Swap in the entry as Library now describes it, rather than reloading the whole shelf for one
    /// card's change. The status filter is applied where the cards are read, so a card that changed
    /// status simply falls under a different tab on the next render — nothing to reload.
    /// </summary>
    private void Replace(LibraryEntry updated) =>
        _entries = _entries?.Select(entry => entry.Id == updated.Id ? updated : entry).ToArray();

    private void RemoveAsync(Guid entryId) =>
        _entries = _entries?.Where(entry => entry.Id != entryId).ToArray();

    private void SignedOut()
    {
        _entries = null;
        _problem = LibraryUnavailable.NotSignedIn;
    }

    /// <summary>
    /// The same journey out to Google the header's control makes. A landing page whose only way in
    /// is a control in the corner is a landing page with no call to action.
    /// </summary>
    private void SignIn() => Navigation.NavigateToLogin("authentication/login");

    private async Task SearchOnEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    /// <summary>
    /// Whether the phone's search dock is open. Only the + button sets it, and the button only
    /// exists on a phone, so on a wider screen this stays false and the panel is simply there.
    /// </summary>
    private bool _searchOpen;
    private bool _focusQuery;

    /// <summary>
    /// Set when a page of results has just come back, so the render that shows it is followed by
    /// a scroll to its top. A page read from part-way down is a page the reader has to scroll
    /// up through to find the start of.
    /// </summary>
    private bool _showResultsTop;
    private bool _sheetAttached;
    private ElementReference _queryBox;
    private ElementReference _dockEl;
    private ElementReference _fabEl;

    /// <summary>Whether the + now on screen has its in-tap opener (sheet.js armOpener) attached.</summary>
    private bool _fabArmed;
    private IJSObjectReference? _sheet;
    private IJSObjectReference? _exit;

    private void OpenSearch()
    {
        _searchOpen = true;
        // The dock opens to be typed in: the cursor goes in the box. On a phone sheet.js has
        // already put it there, inside the tap, which is the only place a phone will raise its
        // keyboard from; this is for everywhere else, done after the render, once the box exists.
        _focusQuery = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Fetched now, while nothing is waiting on it, rather than at the first tap on +. Loaded
        // on demand it arrived a beat after the dock had already been painted, and the dock spent
        // that beat at whatever height it had before the script took it over.
        if (firstRender)
        {
            _sheet = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sheet.js");
            _exit = await JS.InvokeAsync<IJSObjectReference>("import", "./js/motion.js");
        }

        if (_focusQuery)
        {
            _focusQuery = false;
            await _queryBox.FocusAsync();
        }

        // Whenever the + is on screen it is armed to open the dock inside the tap. It is a fresh
        // element each time the dock closes, so this is asked again after each close — and until
        // the button is actually in the page, since the first renders may be the sign-in screen.
        if (!_searchOpen && !_fabArmed && _sheet is not null)
        {
            _fabArmed = await _sheet.InvokeAsync<bool>("armOpener", _fabEl, _dockEl);
        }

        if (_showResultsTop && _sheet is not null)
        {
            _showResultsTop = false;
            await _sheet.InvokeVoidAsync("showTop", _dockEl);
        }

        // The dock is a draggable bottom sheet on a phone; sheet.js owns its height while it is
        // open. A no-op on a wide screen (no handle, no pointer drag), so it is safe to attach
        // whenever the dock opens and detach when it closes.
        if (_searchOpen && !_sheetAttached && _sheet is not null)
        {
            // Opened at its peek: the dock is a field to type in until there is something to
            // show, and half a screen of empty sheet is not that. It grows when the library
            // answers. The stylesheet has already painted it at the peek, so this is the script
            // agreeing with what is on screen rather than changing it.
            await _sheet.InvokeVoidAsync("attach", _dockEl, "peek");
            _sheetAttached = true;
        }
    }

    private async Task ClearSearch()
    {
        // The phone's dock drops away before it is closed; closing it first would leave nothing
        // on screen to play that on.
        if (_searchOpen && _exit is not null)
        {
            await _exit.InvokeVoidAsync("playOut", _dockEl);
        }

        _query = "";
        _searched = null;
        _results = null;
        _searchProblem = null;
        _addProblem = null;
        _searchOpen = false;
        _fabArmed = false;
        StopAddingByHand();

        if (_sheetAttached && _sheet is not null)
        {
            await _sheet.InvokeVoidAsync("detach", _dockEl);
            _sheetAttached = false;
        }
    }

    /// <summary>
    /// Every keystroke narrows the shelf (VisibleEntries reads the box directly). Editing the query
    /// after a library search leaves the old results labelling the wrong words, so they are dropped
    /// until the next Enter.
    /// </summary>
    private void OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";

        if (_searched is not null && !string.Equals(_searched, _query.Trim(), StringComparison.Ordinal))
        {
            _results = null;
            _searchProblem = null;
            _searched = null;
        }
    }

    private async Task SearchAsync()
    {
        // Nothing typed in means nothing to ask Catalog: sending the request anyway would just
        // come back as a 400, which is not a state this page needs to show.
        if (string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _searched = _query.Trim();

        // A new search is a new question, so it is asked from the first page — and any form
        // opened for the last one's dead end no longer belongs to it.
        StopAddingByHand();

        await ShowPageAsync(1);
    }

    private async Task ShowPageAsync(int page)
    {
        if (_searched is not { } query || page < 1)
        {
            return;
        }

        _searching = true;
        _addProblem = null;

        try
        {
            (_results, _searchProblem) = await Catalog.SearchAsync(query, page, CancellationToken.None);
        }
        finally
        {
            _searching = false;
        }

        // A page that came back is read from its first result. A problem is not a page: there
        // is nothing to start from the top of, and the notice sits where the reader already is.
        _showResultsTop = _searchProblem is null;

        // The phone's dock has been a field at the foot of the screen until now; with an answer to
        // show — results, or a notice saying why there are none — it comes up to half the screen,
        // which the reader can then drag either way. Only from the peek: a sheet the reader has
        // already sized is left as they left it, page after page.
        if (_sheetAttached && _sheet is not null)
        {
            await _sheet.InvokeVoidAsync("grow", _dockEl);
        }
    }

    /// <summary>
    /// Offered only once search has come back empty, so a reader reaches for it having already
    /// established that the Catalog cannot help — which is what keeps it from filling up with
    /// hand-typed duplicates of books it already holds. What they searched for is what they
    /// were looking for, so the form opens with it rather than asking them to type it twice.
    /// </summary>
    private void StartAddingByHand()
    {
        _addingByHand = true;
        _creation = null;
        _addProblem = null;

        // The one box does not say which it held, so the same shape test Catalog applies is
        // applied here: digits in the shape of an ISBN go in the ISBN box, anything else was words.
        var typed = _searched ?? "";
        var looksLikeIsbn = typed.Replace("-", "").Replace(" ", "") is { Length: 10 or 13 } bare
            && bare[..^1].All(char.IsAsciiDigit)
            && (char.IsAsciiDigit(bare[^1]) || bare.Length == 10 && char.ToUpperInvariant(bare[^1]) == 'X');

        _newTitle = looksLikeIsbn ? "" : typed;
        _newAuthors = "";
        _newIsbn = looksLikeIsbn ? typed.Replace("-", "").Replace(" ", "") : "";
        _newCoverUrl = "";
        _newTotalPages = null;
    }

    private void StopAddingByHand()
    {
        _addingByHand = false;
        _creation = null;
    }

    /// <summary>What Catalog said about one of the form's fields when it last refused.</summary>
    private IReadOnlyList<string> Rejected(string field) => _creation?.For(field) ?? [];

    /// <summary>
    /// Two calls, deliberately: the Book belongs to the shared Catalog and the entry belongs to
    /// this reader, and they are different services' business. If the second fails the Book still
    /// exists, which is correct — a Book is nobody's — so the failure is reported and nothing is
    /// unwound.
    /// </summary>
    private async Task AddByHandAsync()
    {
        _creating = true;
        _creation = null;
        _addProblem = null;

        try
        {
            var authors = _newAuthors
                .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

            var creation = await Catalog.CreateAsync(
                new NewBook(
                    _newTitle,
                    authors,
                    Blank(_newIsbn),
                    Blank(_newCoverUrl),
                    _newTotalPages),
                CancellationToken.None);

            _creation = creation;

            if (!creation.Ok || creation.Book is not { } book)
            {
                return;
            }

            var (added, problem) = await Gateway.AddAsync(book.Id, CancellationToken.None);

            if (problem is { } trouble)
            {
                _addProblem = trouble;
                return;
            }

            // On the shelf now, so the dead end that led here is over: close the form and clear
            // the results it came from.
            StopAddingByHand();
            _results = null;
            _searched = null;

            await ShowAddedAsync(added);
        }
        finally
        {
            _creating = false;
        }
    }

    /// <summary>Catalog trims and null-checks its optional fields; an empty box is not a value.</summary>
    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task AddToLibraryAsync(Guid bookId)
    {
        _addProblem = null;
        _adding = bookId;

        try
        {
            var (added, problem) = await Gateway.AddAsync(bookId, CancellationToken.None);

            if (problem is { } trouble)
            {
                _addProblem = trouble;
                return;
            }

            await ShowAddedAsync(added);
        }
        finally
        {
            _adding = null;
        }
    }

    /// <summary>
    /// A book goes on the shelf as Want to read, and under any other filter it would land out of
    /// sight — added, and nothing to show for it. The shelf follows it to its tab. Then the same
    /// fetch the page loads with, rather than splicing the new entry in by hand, so the shelf
    /// always shows exactly what the Gateway says it holds.
    /// </summary>
    private async Task ShowAddedAsync(LibraryEntry? added)
    {
        if (added is { } entry && _filter is not null && _filter != entry.Status)
        {
            _filter = entry.Status;
            Memory.Remember(_filter);
        }

        await LoadShelfAsync();
    }
}
