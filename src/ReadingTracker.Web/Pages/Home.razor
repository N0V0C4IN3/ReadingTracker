@page "/"
@using Microsoft.Extensions.Options
@using ReadingTracker.Web.Components
@using ReadingTracker.Web.Services
@using ReadingTracker.Web.Layout
@inject GatewayLibraryClient Gateway
@inject GatewayCatalogClient Catalog
@inject IOptions<DevSignInOptions> DevSignIn
@inject NavigationManager Navigation

<PageTitle>ReadingTracker</PageTitle>

<AuthorizeView>
    @*
        Until the answer to "is anyone signed in" is actually in, neither the shelf nor the welcome
        screen is the right thing to show. Without this the welcome screen renders first and is
        swapped out a moment later, so every signed-in reader is greeted by a flash of the page
        that asks them to sign in.
    *@
    <Authorizing>
        <Settling />
    </Authorizing>
    <Authorized>
        <section class="shelf">
            <div class="shelf__heading">
                <h1>Your shelf</h1>

                @if (_entries is { Count: > 0 } || _filter is not null)
                {
                    <div class="filters" role="group" aria-label="Filter by reading status">
                        @foreach (var (value, label) in Filters)
                        {
                            <button type="button"
                                    class="chip @(value == _filter ? "chip--on" : null)"
                                    aria-pressed="@(value == _filter)"
                                    @onclick="() => FilterAsync(value)">
                                @label
                            </button>
                        }
                    </div>
                }
            </div>

            @if (_entries is { } entries)
            {
                @if (entries.Count == 0)
                {
                    <p class="empty">
                        @if (_filter is null)
                        {
                            <text>Your shelf is empty. Search for a book below to add your first one.</text>
                        }
                        else
                        {
                            <text>Nothing here with that status.</text>
                        }
                    </p>
                }
                else
                {
                    <div class="entries">
                        @foreach (var entry in entries)
                        {
                            <ShelfEntry @key="entry.Id"
                                        Entry="entry"
                                        OnChanged="Replace"
                                        OnRemoved="@(() => RemoveAsync(entry.Id))"
                                        OnSignedOut="SignedOut" />
                        }
                    </div>
                }
            }
            else if (_problem == LibraryUnavailable.NotSignedIn)
            {
                <p class="notice">Your session has ended. <a href="authentication/login">Sign in again</a> to see your shelf.</p>
            }
            else if (_problem == LibraryUnavailable.GatewayUnreachable)
            {
                <p class="notice">ReadingTracker could not be reached just now. Try again shortly.</p>
            }
            else
            {
                <p class="muted">Loading your shelf…</p>
            }
        </section>

        <section class="search">
            <h2>Find a book</h2>

            <div class="search__inputs">
                <input @bind="_titleQuery" @bind:event="oninput" placeholder="Title" aria-label="Title" @onkeydown="SearchOnEnterAsync" />
                <input @bind="_authorQuery" @bind:event="oninput" placeholder="Author (optional)" aria-label="Author" @onkeydown="SearchOnEnterAsync" />
                <input @bind="_isbnQuery" @bind:event="oninput" placeholder="ISBN" aria-label="ISBN" @onkeydown="SearchOnEnterAsync" />
                <button type="button" @onclick="SearchAsync" disabled="@_searching">
                    @(_searching ? "Searching…" : "Search")
                </button>
            </div>

            @if (_results is { } found)
            {
                @if (found.Results.Count == 0)
                {
                    <p class="muted">
                        @(found.Page > 1 ? "Nothing more on this page." : "No books matched your search.")
                    </p>

                    @if (!_addingByHand)
                    {
                        <p>
                            <button type="button" class="button--primary" @onclick="StartAddingByHand">
                                Add it by hand
                            </button>
                        </p>
                    }
                }
                else
                {
                    <ul class="results">
                        @foreach (var book in found.Results)
                        {
                            <li class="result">
                                @if (book.CoverUrl is { } cover)
                                {
                                    <img src="@cover" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <div class="result__cover-placeholder" aria-hidden="true"></div>
                                }

                                <div class="result__body">
                                    <strong>@book.Title</strong>
                                    @if (book.Authors.Count > 0)
                                    {
                                        <span class="muted">@string.Join(", ", book.Authors)</span>
                                    }
                                </div>

                                <button type="button"
                                        class="button--primary"
                                        @onclick="() => AddToLibraryAsync(book.Id)"
                                        disabled="@(_adding == book.Id)">
                                    @(_adding == book.Id ? "Adding…" : "Add to my library")
                                </button>
                            </li>
                        }
                    </ul>
                }

                @* Only worth showing once there is somewhere to go: a single page of results
                   needs no way to leave it. *@
                @if (found.Page > 1 || found.HasMore)
                {
                    <nav class="pager" aria-label="Search result pages">
                        <button type="button"
                                disabled="@(found.Page <= 1 || _searching)"
                                @onclick="() => ShowPageAsync(found.Page - 1)">
                            Previous
                        </button>

                        <span class="muted">Page @(found.Page)</span>

                        <button type="button"
                                disabled="@(!found.HasMore || _searching)"
                                @onclick="() => ShowPageAsync(found.Page + 1)">
                            Next
                        </button>
                    </nav>
                }
            }
            else if (_searchProblem == SearchUnavailable.ProvidersUnavailable)
            {
                <p class="notice">Book search is temporarily unavailable. Try again shortly.</p>
            }
            else if (_searchProblem == SearchUnavailable.NotSignedIn)
            {
                <p class="notice">Your session has ended. <a href="authentication/login">Sign in again</a> to search.</p>
            }
            else if (_searchProblem == SearchUnavailable.GatewayUnreachable)
            {
                <p class="notice">ReadingTracker could not be reached just now. Try again shortly.</p>
            }

            @if (_addingByHand)
            {
                <div class="panel by-hand">
                    <h3>Add a book by hand</h3>
                    <p class="hint">Only the title and author are needed. The rest is whatever you know.</p>

                    <div class="field">
                        <label for="by-hand-title">Title</label>
                        <input id="by-hand-title" @bind="_newTitle" @bind:event="oninput" />
                        @foreach (var message in Rejected("Title"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-authors">Author(s)</label>
                        <input id="by-hand-authors" @bind="_newAuthors" @bind:event="oninput" />
                        <p class="hint">Separate more than one with a comma.</p>
                        @foreach (var message in Rejected("Authors"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-isbn">ISBN</label>
                        <input id="by-hand-isbn" @bind="_newIsbn" @bind:event="oninput" />
                        @foreach (var message in Rejected("Isbn"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-cover">Cover URL</label>
                        <input id="by-hand-cover" @bind="_newCoverUrl" @bind:event="oninput" />
                        @foreach (var message in Rejected("CoverUrl"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    <div class="field">
                        <label for="by-hand-pages">Pages</label>
                        <input id="by-hand-pages" type="number" min="1" @bind="_newTotalPages" />
                        @foreach (var message in Rejected("TotalPages"))
                        {
                            <p class="hint hint--bad">@message</p>
                        }
                    </div>

                    @if (_creation?.Problem == BookCreationProblem.IsbnAlreadyInCatalog)
                    {
                        <p class="notice notice--bad">
                            That ISBN is already in the catalog. Search for it by ISBN and add it from the results.
                        </p>
                    }
                    else if (_creation?.Problem == BookCreationProblem.NotSignedIn)
                    {
                        <p class="notice notice--bad">
                            Your session has ended. <a href="authentication/login">Sign in again</a> to add books.
                        </p>
                    }
                    else if (_creation?.Problem == BookCreationProblem.GatewayUnreachable)
                    {
                        <p class="notice notice--bad">ReadingTracker could not be reached just now. Try again shortly.</p>
                    }

                    <div class="session-form__actions">
                        <button type="button" class="button--primary" @onclick="AddByHandAsync" disabled="@_creating">
                            @(_creating ? "Adding…" : "Add to my library")
                        </button>
                        <button type="button" class="link-button" @onclick="StopAddingByHand" disabled="@_creating">
                            Cancel
                        </button>
                    </div>
                </div>
            }

            @if (_addProblem == AddToLibraryProblem.AlreadyInLibrary)
            {
                <p class="notice">You already have that book in your library.</p>
            }
            else if (_addProblem == AddToLibraryProblem.NotSignedIn)
            {
                <p class="notice">Your session has ended. <a href="authentication/login">Sign in again</a> to add books.</p>
            }
            else if (_addProblem == AddToLibraryProblem.GatewayUnreachable)
            {
                <p class="notice">ReadingTracker could not be reached just now. Try again shortly.</p>
            }
        </section>
    </Authorized>
    <NotAuthorized>
        @*
            The one screen with no reader behind it, so there is nothing of theirs to show. It
            shows books instead: a deck of jackets under the greeting, over drawn ones, because a
            welcome screen that waits on a cover service is a welcome screen that sometimes greets
            people with nothing.

            The jackets are fetched while the runtime is still starting, but on a cold visit they
            can still be a moment behind it. Rather than show the screen and let it finish dressing
            in front of the reader, the loading animation stays up for that moment too: the last
            half second of the wait belongs to the wait, not to the page.

            The screen underneath is built and painted the whole time — it is a curtain over a
            finished set, not a screen being assembled. That is what lets the two cross-fade
            instead of one replacing the other: there is nothing to swap in at the end, only
            something to take away.
        *@
        <div class="welcome @(_welcomeDressed ? "welcome--shown" : null)">
            <div class="welcome__curtain @(_welcomeDressed ? "welcome__curtain--lifted" : null)"
                 aria-hidden="@_welcomeDressed">
                <Settling />
            </div>

        <section class="hero">
            <div class="hero__content">
                <p class="hero__greeting">@Greeting</p>
                <h1 class="hero__title">ReadingTracker</h1>
                <p class="hero__pitch">Track what you are reading, and how far through it you are.</p>

                <div class="hero__actions">
                    @if (DevSignIn.Value.Enabled)
                    {
                        <DevSignInForm />
                    }
                    else
                    {
                        <button type="button" class="button--primary button--large" @onclick="SignIn">
                            Sign in with Google
                        </button>
                    }
                </div>
            </div>

            <CoverFlow Dressed="ShowWelcome" />
        </section>

        <section class="pitch">
            <p>
                Your shelf holds <strong>what you are reading</strong>, what you have finished and what
                you have put down. Log a stretch of reading and it works out <strong>how far through
                you are</strong> — in pages or in percent, whichever you think in.
            </p>
        </section>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Whether the welcome screen's jackets are in place. Until they are, the screen is behind the
    /// loading curtain — built, painted and waiting, rather than held back from rendering. The
    /// deck has to be in the page for its covers to be fetched at all.
    /// </summary>
    private bool _welcomeDressed;

    private void ShowWelcome() => _welcomeDressed = true;

    /// <summary>The reader's own clock: this runs in their browser, so it is their time of day.</summary>
    private static string Greeting => DateTime.Now.Hour switch
    {
        < 5 => "Still awake",
        < 12 => "Good morning",
        < 18 => "Good afternoon",
        _ => "Good evening",
    };

    /// <summary>Null is "everything"; the rest are the ReadingStatus values Library accepts.</summary>
    private static readonly (string? Value, string Label)[] Filters =
    [
        (null, "All"),
        ("Reading", "Reading"),
        ("WantToRead", "Want to read"),
        ("Finished", "Finished"),
        ("OnHold", "On hold"),
        ("Dropped", "Dropped"),
    ];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IReadOnlyList<LibraryEntry>? _entries;
    private LibraryUnavailable? _problem;
    private string? _filter;

    private string _titleQuery = "";
    private string _authorQuery = "";
    private string _isbnQuery = "";

    /// <summary>
    /// What was actually searched for, which is not the same thing as what is in the boxes now.
    /// Paging re-runs this rather than whatever the reader has since typed, so pressing Next
    /// never quietly changes the query underneath them.
    /// </summary>
    private (string Isbn, string Title, string Author)? _searched;

    private BookSearchPage? _results;
    private SearchUnavailable? _searchProblem;
    private AddToLibraryProblem? _addProblem;
    private bool _searching;
    private Guid? _adding;

    private bool _addingByHand;
    private string _newTitle = "";
    private string _newAuthors = "";
    private string _newIsbn = "";
    private string _newCoverUrl = "";
    private int? _newTotalPages;
    private bool _creating;

    /// <summary>What Catalog said the last time this form was submitted, field by field.</summary>
    private BookCreation? _creation;

    /// <summary>Whose shelf is on screen, so a re-render is not mistaken for a change of reader.</summary>
    private string? _shelfBelongsTo;

    // Not OnInitializedAsync: signing in does not always reload the page. Google's does, because it
    // is a redirect out and back, but dev sign-in (ADR-0009) happens in place — so a page that only
    // ever fetched on initialisation would sit on "Loading your shelf…" until the reader refreshed
    // by hand. Reacting to the cascaded authentication state instead covers both.
    protected override async Task OnParametersSetAsync()
    {
        var state = AuthenticationState is null ? null : await AuthenticationState;

        var reader = state?.User.Identity?.IsAuthenticated is true
            ? state.User.FindFirst("sub")?.Value ?? state.User.Identity.Name
            : null;

        if (reader == _shelfBelongsTo)
        {
            return;
        }

        _shelfBelongsTo = reader;

        // One reader's results must never be left on screen for the next one.
        _entries = null;
        _problem = null;
        _results = null;
        _searched = null;
        _searchProblem = null;
        _addProblem = null;
        _filter = null;
        StopAddingByHand();

        // Fetching before we know there is a reader would send the Gateway a request with no
        // token on every anonymous page load — harmless, since it just gets a 401 back, but
        // pointless network traffic for a page that has already decided not to show it.
        if (reader is not null)
        {
            await LoadShelfAsync();
        }
    }

    private async Task LoadShelfAsync() =>
        (_entries, _problem) = await Gateway.GetEntriesAsync(_filter, CancellationToken.None);

    private async Task FilterAsync(string? status)
    {
        if (_filter == status)
        {
            return;
        }

        _filter = status;
        _entries = null;

        await LoadShelfAsync();
    }

    /// <summary>
    /// Swap in the entry as Library now describes it, rather than reloading the whole shelf for
    /// one card's change. A status change under an active filter can move a book off the shelf
    /// entirely, though, and leaving it sitting there would misreport what the filter says.
    /// </summary>
    private async Task Replace(LibraryEntry updated)
    {
        if (_filter is { } filter && updated.Status != filter)
        {
            await LoadShelfAsync();
            return;
        }

        _entries = _entries?.Select(entry => entry.Id == updated.Id ? updated : entry).ToArray();
    }

    private async Task RemoveAsync(Guid entryId)
    {
        _entries = _entries?.Where(entry => entry.Id != entryId).ToArray();

        // The card has already gone; this keeps anything derived from the shelf honest.
        await LoadShelfAsync();
    }

    private void SignedOut()
    {
        _entries = null;
        _problem = LibraryUnavailable.NotSignedIn;
    }

    /// <summary>
    /// The same journey out to Google the header's control makes. A landing page whose only way in
    /// is a control in the corner is a landing page with no call to action.
    /// </summary>
    private void SignIn() => Navigation.NavigateToLogin("authentication/login");

    private async Task SearchOnEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        // Nothing typed in means nothing to ask Catalog: sending the request anyway would just
        // come back as a 400, which is not a state this page needs to show.
        if (string.IsNullOrWhiteSpace(_isbnQuery) &&
            string.IsNullOrWhiteSpace(_titleQuery) &&
            string.IsNullOrWhiteSpace(_authorQuery))
        {
            return;
        }

        _searched = (_isbnQuery, _titleQuery, _authorQuery);

        // A new search is a new question, so it is asked from the first page — and any form
        // opened for the last one's dead end no longer belongs to it.
        StopAddingByHand();

        await ShowPageAsync(1);
    }

    private async Task ShowPageAsync(int page)
    {
        if (_searched is not { } query || page < 1)
        {
            return;
        }

        _searching = true;
        _addProblem = null;

        try
        {
            (_results, _searchProblem) =
                await Catalog.SearchAsync(query.Isbn, query.Title, query.Author, page, CancellationToken.None);
        }
        finally
        {
            _searching = false;
        }
    }

    /// <summary>
    /// Offered only once search has come back empty, so a reader reaches for it having already
    /// established that the Catalog cannot help — which is what keeps it from filling up with
    /// hand-typed duplicates of books it already holds. What they searched for is what they
    /// were looking for, so the form opens with it rather than asking them to type it twice.
    /// </summary>
    private void StartAddingByHand()
    {
        _addingByHand = true;
        _creation = null;
        _addProblem = null;

        _newTitle = _searched?.Title ?? "";
        _newAuthors = _searched?.Author ?? "";
        _newIsbn = _searched?.Isbn ?? "";
        _newCoverUrl = "";
        _newTotalPages = null;
    }

    private void StopAddingByHand()
    {
        _addingByHand = false;
        _creation = null;
    }

    /// <summary>What Catalog said about one of the form's fields when it last refused.</summary>
    private IReadOnlyList<string> Rejected(string field) => _creation?.For(field) ?? [];

    /// <summary>
    /// Two calls, deliberately: the Book belongs to the shared Catalog and the entry belongs to
    /// this reader, and they are different services' business. If the second fails the Book still
    /// exists, which is correct — a Book is nobody's — so the failure is reported and nothing is
    /// unwound.
    /// </summary>
    private async Task AddByHandAsync()
    {
        _creating = true;
        _creation = null;
        _addProblem = null;

        try
        {
            var authors = _newAuthors
                .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

            var creation = await Catalog.CreateAsync(
                new NewBook(
                    _newTitle,
                    authors,
                    Blank(_newIsbn),
                    Blank(_newCoverUrl),
                    _newTotalPages),
                CancellationToken.None);

            _creation = creation;

            if (!creation.Ok || creation.Book is not { } book)
            {
                return;
            }

            var (_, problem) = await Gateway.AddAsync(book.Id, CancellationToken.None);

            if (problem is { } trouble)
            {
                _addProblem = trouble;
                return;
            }

            // On the shelf now, so the dead end that led here is over: close the form and clear
            // the results it came from.
            StopAddingByHand();
            _results = null;
            _searched = null;

            await LoadShelfAsync();
        }
        finally
        {
            _creating = false;
        }
    }

    /// <summary>Catalog trims and null-checks its optional fields; an empty box is not a value.</summary>
    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task AddToLibraryAsync(Guid bookId)
    {
        _addProblem = null;
        _adding = bookId;

        try
        {
            var (_, problem) = await Gateway.AddAsync(bookId, CancellationToken.None);

            if (problem is { } trouble)
            {
                _addProblem = trouble;
                return;
            }

            // Rerun the same fetch the page loads with, rather than splicing the new entry in by
            // hand, so the shelf always shows exactly what the Gateway says it holds.
            await LoadShelfAsync();
        }
        finally
        {
            _adding = null;
        }
    }
}
