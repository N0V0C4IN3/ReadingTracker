@page "/shelf/{EntryId:guid}"
@using ReadingTracker.Web.Services
@inject GatewayLibraryClient Library
@inject GatewayCatalogClient Catalog
@inject NavigationManager Navigation
@inject ShelfMemory Memory
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    The Book page: one LibraryEntry in full. Reached from the cover or title of a shelf card,
    and only for a book on the reader's shelf — a search result has no page, and an entry that
    is not theirs or is gone says so rather than bouncing them back to the shelf, so a dead link
    reads as dead.

    One column, at most 640px, the same on a phone and on a desk. The book half first — cover,
    title, authors, what it is about, the edition line — because that is what somebody came for;
    the reading half follows below it, and is BookReading's: everything the shelf card can do,
    done here with more room. What it changes it hands back up, and the page shows the entry
    Library answered with — the same entry, the device linked to it untouched.

    The two halves come from two places and arrive on their own: the entry from Library, and the
    Book's longer details from Catalog, which may be going to the provider for them the first
    time anybody asks. Neither waits for the other, and Catalog having nothing to say — or not
    being reachable — costs the book half one line, not the page.

    The page wears the jacket's colours: the mesh behind it and the accent on it are taken from
    the cover (js/coverPalette.js), and put back to the theme's own when the page is left. A
    third arrival, and the quietest: a cover that cannot be had leaves the theme's colours.
*@

<PageTitle>@(_entry?.Book?.Title ?? "Your shelf") · ReadingTracker</PageTitle>

<AuthorizeView>
    <Authorizing>
        <Settling />
    </Authorizing>
    <NotAuthorized>
        <section class="book">
            <a class="book__back" href="" aria-label="Your shelf"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <p class="notice">Sign in to see this book. You will be brought back here.</p>
            <button type="button" class="button--primary" @onclick="SignIn">Sign in</button>
        </section>
    </NotAuthorized>
    <Authorized>
        <section class="book">
            <a class="book__back" href="" aria-label="Your shelf"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a>

            @if (_entry is { } entry)
            {
                @*
                    The reading half draws the head, so the status can stand at its right end,
                    level with the title: the status is one of the changes the reading half owns.
                *@
                <BookReading Entry="entry"
                             OnChanged="Changed"
                             OnRemoved="Removed"
                             OnSignedOut="SignedOut">
                    <Head>
                        <div class="book__cover">
                            @if (entry.Book?.CoverUrl is { } cover)
                            {
                                <img src="@cover" alt="" />
                            }
                            else
                            {
                                <div class="entry__cover-placeholder" aria-hidden="true">@Initial(entry)</div>
                            }
                        </div>
                        <div class="book__ident">
                            <h1 class="book__title">@(entry.Book?.Title ?? "(catalog unreachable)")</h1>
                            @if (Byline(entry) is { } byline)
                            {
                                <p class="book__authors">@byline</p>
                            }
                            <div class="book__reveal book__reveal--chips @Revealed">
                                <div class="book__reveal-inner">
                                    @if (_book is { Categories.Count: > 0 } placed)
                                    {
                                        <ul class="book__categories" aria-label="Categories">
                                            @foreach (var category in placed.Categories)
                                            {
                                                <li class="chip chip--tag">@category</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </Head>
                    <ChildContent>
                    @*
                        Catalog's part comes in after the rest of the page is already standing, so it
                        is given a box that is there from the start with nothing in it, and opens to
                        whatever Catalog said: what is under it is pushed down along with the box
                        rather than jumping the height of the description in one frame.
                    *@
                    <div class="book__reveal @Revealed">
                    <div class="book__reveal-inner">
                    @if (_book is { Paragraphs.Count: > 0 } described)
                    {
                        @*
                            Folded, the description is the same height on every book: a fixed number of
                            lines, cut with an ellipsis wherever the cut falls (the stylesheet does both).
                            Read more unfolds the whole of it, and it folds back.
                        *@
                        <div class="book__about @(_readingMore ? null : "book__about--folded")">
                            <div class="book__text">
                                @foreach (var paragraph in described.Paragraphs)
                                {
                                    <p>@paragraph</p>
                                }
                            </div>
                            @if (Unfolds(described))
                            {
                                <button type="button" class="link-button book__more" @onclick="() => _readingMore = !_readingMore">
                                    @(_readingMore ? "Show less" : "Read more")
                                </button>
                            }
                        </div>
                    }
                    else if (_book is { DetailsUnavailable: true } || _bookProblem is BookUnavailable.GatewayUnreachable)
                    {
                        <p class="hint book__note">The book's details could not be fetched just now. They will be here next time.</p>
                    }
                    </div>
                    </div>

                    @{ var facts = EditionFacts(entry).ToList(); }

                    <p class="book__edition">
                        @foreach (var (fact, at) in facts.Select((fact, at) => (fact, at)))
                        {
                            @if (at > 0)
                            {
                                <span class="book__dot" aria-hidden="true">·</span>
                            }
                            <span>@fact</span>
                        }
                        @if (_book is { ProviderUrl: { } providerUrl, ProviderName: { } providerName })
                        {
                            @if (facts.Count > 0)
                            {
                                <span class="book__dot" aria-hidden="true">·</span>
                            }
                            <a href="@providerUrl" target="_blank" rel="noopener">@providerName ↗</a>
                        }
                    </p>
                    </ChildContent>
                </BookReading>
            }
            else if (_problem is LibraryUnavailable.NotSignedIn)
            {
                <p class="notice">Your session has ended. <a href="authentication/login">Sign in again</a> to see this book.</p>
            }
            else if (_problem is LibraryUnavailable.GatewayUnreachable)
            {
                <p class="notice notice--bad">ReadingTracker could not be reached just now. Try again shortly.</p>
            }
            else if (_answered)
            {
                <h1 class="book__title">Not on your shelf</h1>
                <p class="muted">There is no book at this address on your shelf — it may have been removed, or the link was never yours.</p>
                <p><a href="">Back to your shelf</a></p>
            }
            else
            {
                @*
                    Nothing is drawn for this wait, on purpose. The page is already showing it:
                    the jacket's colours are put on before anything is fetched and the cover is
                    asked for alongside Library rather than after it, so the mesh is this book's
                    mesh while this book is on its way, and it eases rather than blinks. A wait
                    drawn on top of that is a second, louder answer to a question already
                    answered — and a worse one, because it is the same shape for every book.

                    The Settling above is a different case and stays: it covers the handover
                    from the runtime's own boot screen, where there is no page yet to speak for
                    itself, and taking it out would put a blank frame in the middle of that.

                    None of the mesh reaches a screen reader, so the wait is still said here.
                *@
                <span class="visually-hidden" role="status">Loading</span>
            }
        </section>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter]
    public Guid EntryId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>
    /// Whether the description is long enough to be worth unfolding. The fold is a number of
    /// lines, which is not known here, so this is the length of text that fills it on a phone —
    /// on a wider screen a description a little over this fits and the button unfolds nothing,
    /// which is a small thing next to a button that is missing when it is needed.
    /// </summary>
    private static bool Unfolds(CatalogBook described) =>
        described.Paragraphs.Count > 1 || described.Paragraphs.Sum(paragraph => paragraph.Length) > 300;

    private LibraryEntry? _entry;
    private LibraryUnavailable? _problem;
    private bool _asked;

    private CatalogBook? _book;
    private BookUnavailable? _bookProblem;
    private bool _readingMore;

    /// <summary>Catalog's boxes open once it has answered, whatever it answered — a note that it
    /// could not be reached comes in the same way the description would have.</summary>
    private string? Revealed => _book is not null || _bookProblem is not null ? "book__reveal--open" : null;

    /// <summary>
    /// Whether Library has answered. Between asking and answering the page settles rather than
    /// saying "not on your shelf" for a book that is about to appear.
    /// </summary>
    private bool _answered;

    /// <summary>
    /// js/coverPalette.js, imported once and shared by whoever asks first — the page's first
    /// paint and the cover's arrival race, and either may need it first.
    /// </summary>
    private Task<IJSObjectReference>? _palette;

    private Task<IJSObjectReference> PaletteAsync() =>
        _palette ??= JS.InvokeAsync<IJSObjectReference>("import", "./js/coverPalette.js").AsTask();

    /// <summary>Asked for once somebody is signed in; before that the answer would be a 401.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_asked || AuthState is not { } pending || (await pending).User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        _asked = true;

        // Painted from what was read of the cover last time, before anything is fetched, so a
        // page revisited is in its colours from the first frame.
        await (await PaletteAsync()).InvokeVoidAsync("begin", EntryId);

        // The shelf the reader just tapped knew the cover already: the fetch for its colours
        // starts now, alongside asking Library, rather than after Library has answered.
        var painting = Memory.Recall(EntryId) is { } remembered ? PaintFromCoverAsync(remembered) : null;

        await LoadAsync(painting);
    }

    /// <summary>
    /// The shelf listing is the one way to an entry, and it is light: Library answers with what
    /// the cards need and no more, so asking for the whole shelf to find one book costs what
    /// opening the shelf costs.
    /// </summary>
    private async Task LoadAsync(Task? painting)
    {
        var (entries, problem) = await Library.GetEntriesAsync(null, CancellationToken.None);

        _problem = problem;
        _entry = entries?.FirstOrDefault(entry => entry.Id == EntryId);
        _answered = true;

        if (_entry is null)
        {
            return;
        }

        // The page is on screen from here; the details fill in when Catalog answers, and the
        // colours when the cover does — each on its own, neither waiting for the other.
        StateHasChanged();

        await Task.WhenAll(LoadDetailsAsync(_entry.BookId), painting ?? PaintFromCoverAsync(_entry));
    }

    private async Task LoadDetailsAsync(Guid bookId)
    {
        (_book, _bookProblem) = await Catalog.GetBookAsync(bookId, CancellationToken.None);
        StateHasChanged();
    }

    /// <summary>
    /// The colours are worked out from the cover's bytes in the browser (js/coverPalette.js);
    /// this fetches them and hands them over. Keyed by entry rather than book so a reader's own
    /// cover for a book — should that ever exist — would colour their page and nobody else's.
    /// </summary>
    private async Task PaintFromCoverAsync(LibraryEntry entry)
    {
        if (entry.Book?.CoverUrl is not { Length: > 0 } coverUrl)
        {
            return;
        }

        var bytes = await Catalog.GetCoverAsync(coverUrl, CancellationToken.None);

        if (bytes is null)
        {
            return;
        }

        await (await PaletteAsync()).InvokeVoidAsync("apply", EntryId, bytes);
    }

    public async ValueTask DisposeAsync()
    {
        if (_palette is null)
        {
            return;
        }

        try
        {
            var palette = await _palette;
            await palette.InvokeVoidAsync("end");
            await palette.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is gone with the circuit; there is nothing left to put back.
        }
    }

    /// <summary>The authors, and after them who put the book out and when, the way a jacket flap says it.</summary>
    private string? Byline(LibraryEntry entry)
    {
        var authors = entry.Book is { Authors.Count: > 0 } book ? string.Join(", ", book.Authors) : null;
        var byline = string.Join(" · ", new[] { authors, _book?.Imprint }.OfType<string>());

        return byline.Length == 0 ? null : byline;
    }

    private void SignIn() => Navigation.NavigateToLogin("authentication/login");

    /// <summary>Library answered a change with the entry as it now is; that is what the page shows.</summary>
    private void Changed(LibraryEntry fresh) => _entry = fresh;

    /// <summary>The book is off the shelf, so its page is over; back to the shelf, where it is gone.</summary>
    private void Removed() => Navigation.NavigateTo("");

    private void SignedOut()
    {
        _entry = null;
        _problem = LibraryUnavailable.NotSignedIn;
    }

    private static string Initial(LibraryEntry entry) =>
        (entry.Book?.Title ?? "?").Trim() is { Length: > 0 } title ? title[..1].ToUpperInvariant() : "?";

    /// <summary>The edition line: what is known of the copy, in the order a jacket flap says it.</summary>
    private static IEnumerable<string> EditionFacts(LibraryEntry entry)
    {
        if (entry.EffectivePageCount is { } pages)
        {
            yield return entry.PageCountOverride is not null ? $"{pages} pages (your count)" : $"{pages} pages";
        }

        if (entry.Book?.Isbn is { Length: > 0 } isbn)
        {
            yield return $"ISBN {isbn}";
        }
    }
}
