@page "/import"
@using ReadingTracker.Web.Services
@implements IDisposable
@inject ImportJob Job

@*
    Bringing a shelf over from Hardcover, Goodreads or StoryGraph. Each exports a CSV; this reads
    it in the browser, shows what it would do, and hands it to the ImportJob, which does it one
    book at a time through the same doors a reader uses by hand — see LibraryImporter — whether or
    not the reader stays on this page. Nothing leaves the browser but the books.

    Two panes: on the left, everything to do — where from, how to get the file, the file, what is
    in it and the button; on the right, the books, in a list that scrolls on its own so the button
    never scrolls away. On a phone they stack and the button waits at the foot of the screen.

    The Gateway paces searches per reader (ADR-0013), so a shelf of fifty takes a few minutes.
    The page counts up as it goes and counts down while it waits, rather than sitting on a spinner.

    Below it, ShelfExport: the way back out, the whole shelf as one CSV.
*@

<PageTitle>Import and export · ReadingTracker</PageTitle>

<AuthorizeView>
    <Authorizing>
        <Settling />
    </Authorizing>
    <NotAuthorized>
        <p class="notice">Sign in to import or export your books.</p>
    </NotAuthorized>
    <Authorized>
        <section class="import">
            <aside class="import__side">
                <h1>Import and export</h1>

                @if (!Job.Running && !Job.Done)
                {
                    <fieldset class="import__from">
                        <legend>From</legend>
                        <div class="import__sources">
                            @foreach (var source in LibraryExport.All)
                            {
                                <label class="import__source @(source == _source ? "import__source--on" : "")">
                                    <input type="radio" name="import-source" checked="@(source == _source)" @onchange="() => Pick(source)" />
                                    <span>@source.Name</span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    <ol class="import__steps">
                        @foreach (var step in _source.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>

                    @if (_file is not { } file)
                    {
                        <label class="import__drop">
                            <InputFile OnChange="ReadAsync" accept=".csv,text/csv" class="visually-hidden" />
                            <span class="import__drop-glyph" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
                            </span>
                            <span class="import__drop-text"><strong>Choose the export</strong><span>@(_source.FileName ?? $"the CSV from {_source.Name}")</span></span>
                        </label>

                        @if (_readingProblem is { } problem)
                        {
                            <p class="notice notice--bad" role="alert">@problem</p>
                        }
                    }
                    else
                    {
                        <div class="import__file">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
                            <span class="import__file-name">@file.Name</span>
                            <button type="button" class="import__change" @onclick="Reset">Change</button>
                        </div>

                        <dl class="import__counts">
                            @foreach (var group in file.Groups)
                            {
                                <dt class="import__tone--@group.Status.ToLowerInvariant()"><span class="status__dot" aria-hidden="true"></span>@ReadingStatuses.Label(group.Status)</dt>
                                <dd>@group.Books.Count</dd>
                            }
                            <dt class="import__counts-all">All</dt>
                            <dd class="import__counts-all">@file.Books.Count</dd>
                        </dl>

                        <div class="import__go">
                            <button type="button" class="button--primary" @onclick="Begin">Import @file.Books.Count @(file.Books.Count == 1 ? "book" : "books")</button>
                            <p class="hint">About @Minutes(file.Books.Count) · you can leave this page</p>
                        </div>
                    }
                }
                else
                {
                    <div class="import__progress" role="status" aria-live="polite">
                        <p class="import__count">
                            @if (Job.Done)
                            {
                                <strong>Done.</strong> <text>@Job.Count(ImportOutcome.Added) added, @Job.Count(ImportOutcome.AlreadyOnShelf) already here@(Job.Count(ImportOutcome.Failed) is > 0 and var failed ? $", {failed} could not be" : "").</text>
                            }
                            else if (Job.WaitingSeconds is { } seconds)
                            {
                                <strong>@Job.Results.Count of @Job.Books.Count</strong> <text>· the library takes ten lookups a minute — carrying on in @seconds s</text>
                            }
                            else
                            {
                                <strong>@Job.Results.Count of @Job.Books.Count</strong> <text>· @Job.Current</text>
                            }
                        </p>
                        <div class="progress__track" aria-hidden="true">
                            <div class="progress__fill" style="width: @(Job.Books.Count == 0 ? 0 : Job.Results.Count * 100 / Job.Books.Count)%"></div>
                        </div>
                    </div>

                    @if (Job.Done)
                    {
                        <div class="import__actions">
                            <a class="button--primary import__shelf" href="/">See your shelf</a>
                            <button type="button" class="link-button" @onclick="Reset">Import another file</button>
                        </div>
                    }
                    else
                    {
                        <p class="hint">You can leave this page; the import carries on and the header shows how it is going.</p>
                    }
                }

                <ShelfExport />
            </aside>

            <div class="import__list">
                @if (Job.Running || Job.Done)
                {
                    <ul class="import__rows import__rows--results">
                        @foreach (var result in Job.Results)
                        {
                            <ImportRow Book="result.Book" Faded="result.Outcome == ImportOutcome.Failed">
                                <span class="pill @PillFor(result.Outcome)">@Describe(result.Outcome)</span>
                                @if (result.Note is { } note)
                                {
                                    <span class="import__note">@note</span>
                                }
                            </ImportRow>
                        }
                    </ul>
                }
                else if (_file is { } loaded)
                {
                    @foreach (var group in loaded.Groups)
                    {
                        <h2 class="import__group import__tone--@group.Status.ToLowerInvariant()">
                            <span class="status__dot" aria-hidden="true"></span>@ReadingStatuses.Label(group.Status) · @group.Books.Count
                        </h2>
                        <ul class="import__rows">
                            @foreach (var book in group.Books)
                            {
                                <ImportRow Book="book">@book.FinishedOn?.ToString("d MMM yyyy")</ImportRow>
                            }
                        </ul>
                    }
                }
                else
                {
                    <p class="import__empty">
                        The books in your file show up here, grouped by how they go on your shelf.
                        Books already on it are left alone; ratings and reviews have no home here and stay behind.
                    </p>
                }
            </div>
        </section>
    </Authorized>
</AuthorizeView>

@code {
    private const long MostBytes = 5 * 1024 * 1024;

    private LibraryExport _source = LibraryExport.Hardcover;
    private Loaded? _file;
    private string? _readingProblem;

    /// <summary>A file read and ready to import: its books, and the same books under each status.</summary>
    private sealed record Loaded(string Name, IReadOnlyList<ImportedBook> Books)
    {
        /// <summary>In the order the shelf lists them; a status it does not know goes last rather than missing.</summary>
        public IReadOnlyList<Group> Groups { get; } =
            [.. Books.GroupBy(book => book.Status)
                .OrderBy(group => ShelfOrder.Rank(group.Key))
                .Select(group => new Group(group.Key, [.. group]))];
    }

    private sealed record Group(string Status, IReadOnlyList<ImportedBook> Books);

    protected override void OnInitialized() => Job.Changed += Redraw;

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    /// <summary>The library looks up ten books a minute.</summary>
    private static string Minutes(int books) => (books + 9) / 10 is var minutes && minutes <= 1 ? "a minute" : $"{minutes} minutes";

    private void Pick(LibraryExport source)
    {
        Reset();
        _source = source;
    }

    private async Task ReadAsync(InputFileChangeEventArgs e)
    {
        _readingProblem = null;

        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MostBytes));
            var text = await reader.ReadToEndAsync();
            var (source, books) = LibraryExport.Parse(text);

            if (books.Count == 0)
            {
                _readingProblem = "There are no books in that file.";
                return;
            }

            _source = source;
            _file = new Loaded(e.File.Name, books);
        }
        catch (NotAnExport problem)
        {
            _readingProblem = problem.Message;
        }
        catch (IOException)
        {
            _readingProblem = "That file is too large to be an export.";
        }
    }

    private void Begin()
    {
        if (_file is { } file && Job.Start(file.Books))
        {
            _file = null;
        }
    }

    private void Reset()
    {
        _file = null;
        _readingProblem = null;
        Job.Clear();
    }

    public void Dispose() => Job.Changed -= Redraw;


    private static string Describe(ImportOutcome outcome) => outcome switch
    {
        ImportOutcome.Added => "Added",
        ImportOutcome.AlreadyOnShelf => "Already here",
        _ => "Could not",
    };

    private static string PillFor(ImportOutcome outcome) => outcome switch
    {
        ImportOutcome.Added => "pill--syncing",
        ImportOutcome.AlreadyOnShelf => "pill--faint",
        _ => "pill--bad",
    };
}
